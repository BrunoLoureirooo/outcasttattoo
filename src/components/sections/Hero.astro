---
/**
 * Hero.astro — full-viewport landing hero
 * Used on: / (index)
 */
import { strings } from '@/content/strings.pt.ts'

const { hero } = strings

// heading may contain \n for line breaks
const headingLines = hero.heading.split('\n')
---

<section class="hero" aria-label="Hero">
  <div class="hero__inner container">
    <div class="hero__content">
      <h1 class="hero__heading">
        {headingLines.map((line, i) => (
          <>
            {line}
            {i < headingLines.length - 1 && <br />}
          </>
        ))}
      </h1>
      <p class="hero__sub">{hero.subheading}</p>
      <a href={hero.ctaHref} class="hero__cta">
        {hero.cta}
      </a>
    </div>
  </div>

  <!-- Decorative thorn motif — inline SVG placeholder -->
  <div class="hero__motif" aria-hidden="true">
    <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" class="hero__motif-svg">
      <circle cx="100" cy="100" r="80" fill="none" stroke="currentColor" stroke-width="1" opacity="0.15" />
      <circle cx="100" cy="100" r="60" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.1" />
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: 4rem; /* nav height */
  }

  .hero__inner {
    position: relative;
    z-index: var(--z-above);
    padding-block: var(--section-pad);
  }

  .hero__content {
    max-width: 760px;
  }

  .hero__heading {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 900;
    line-height: 1.0;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    text-wrap: balance;
    margin-bottom: var(--space-6);
  }

  .hero__sub {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: var(--space-12);
    max-width: 45ch;
  }

  .hero__cta {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-accent);
    border: var(--border-width) solid var(--color-accent);
    padding: var(--space-3) var(--space-8);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition:
      background-color var(--duration-fast) var(--ease-out-expo),
      color var(--duration-fast) var(--ease-out-expo);
  }

  .hero__cta:hover {
    background-color: var(--color-accent);
    color: var(--color-bg);
  }

  /* Decorative motif — bottom-right corner */
  .hero__motif {
    position: absolute;
    bottom: -80px;
    right: -80px;
    width: min(500px, 60vw);
    color: var(--color-ink);
    pointer-events: none;
  }

  .hero__motif-svg {
    width: 100%;
    height: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cta {
      transition: none;
    }
  }
</style>
