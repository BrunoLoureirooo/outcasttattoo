---
/**
 * LocationMap.astro — shop location with Google Maps embed
 * Used on: /sobre
 * Lazy-loaded iframe to avoid blocking page paint.
 */
import { strings } from '@/content/strings.pt.ts'

const { sobre, jsonLd } = strings
const addressLines = sobre.location.address.split('\n')

const mapQuery = encodeURIComponent(
  `${strings.meta.siteName}, ${jsonLd.address.street}, ${jsonLd.address.postal} ${jsonLd.address.city}, Portugal`
)
const mapEmbedUrl = `https://maps.google.com/maps?q=${mapQuery}&z=16&hl=pt&output=embed`
const mapLinkUrl  = `https://maps.google.com/?q=${mapQuery}`
---

<section class="location" aria-labelledby="location-heading">
  <div class="container">
    <div class="location__inner">
      <div class="location__info reveal" data-pending>
        <h2 id="location-heading" class="location__heading">
          {sobre.location.heading}
        </h2>

        <address class="location__address">
          {addressLines.map(line => <p>{line}</p>)}
        </address>

        <div class="location__hours">
          <p class="location__hours-label">{sobre.location.hours.label}</p>
          <p>{sobre.location.hours.weekdays}</p>
          <p>{sobre.location.hours.saturday}</p>
          <p class="location__closed">{sobre.location.hours.closed}</p>
        </div>

        <a
          href={mapLinkUrl}
          class="location__directions"
          target="_blank"
          rel="noopener noreferrer"
        >
          {sobre.location.directions}
        </a>
      </div>

      <div class="location__map reveal" data-pending>
        <iframe
          title="Localização da Outcast Tattoo & Piercing"
          src={mapEmbedUrl}
          width="100%"
          height="100%"
          style="border: 0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          aria-label="Mapa com a localização da Outcast Tattoo & Piercing em Leiria"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .location {
    padding-block: var(--section-pad);
    border-top: var(--border-width) solid var(--color-border);
  }

  .location__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .location__heading {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-ink);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-8);
  }

  .location__address {
    font-style: normal;
    color: var(--color-muted);
    line-height: 1.8;
    margin-bottom: var(--space-8);
  }

  .location__hours {
    color: var(--color-muted);
    line-height: 1.9;
    margin-bottom: var(--space-8);
  }

  .location__hours-label {
    color: var(--color-ink);
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  .location__closed {
    opacity: 0.5;
  }

  .location__directions {
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-accent-dim);
    transition: text-decoration-color var(--duration-fast) ease;
  }

  .location__directions:hover {
    text-decoration-color: var(--color-accent);
  }

  .location__map {
    aspect-ratio: 4 / 3;
    border: var(--border-width) solid var(--color-border);
    overflow: hidden;
    /* dark-mode map: invert light tiles, restore contrast lost in inversion */
    filter: grayscale(100%) invert(92%) contrast(108%) brightness(92%);
  }

  .location__map iframe {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (max-width: 768px) {
    .location__inner {
      grid-template-columns: 1fr;
    }

    .location__map {
      aspect-ratio: 16 / 9;
    }
  }
</style>
