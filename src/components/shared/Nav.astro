---
import { strings } from '@/content/strings.pt.ts'

const { nav } = strings
const currentPath = Astro.url.pathname

const links = [
  { href: '/',       label: nav.home },
  { href: '/sobre',  label: nav.sobre },
  { href: '/marcar', label: nav.marcar },
]
---

<header class="nav" role="banner">
  <div class="nav__inner container">
    <a href="/" class="nav__logo" aria-label={strings.meta.siteName}>
      <span class="nav__logo-text">{strings.meta.siteName}</span>
    </a>

    <nav aria-label={nav.ariaLabel}>
      <ul class="nav__links" role="list">
        {links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={['nav__link', { 'nav__link--active': currentPath === href }]}
              aria-current={currentPath === href ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Mobile toggle — Astro island -->
    <button
      class="nav__burger"
      id="nav-burger"
      aria-label={nav.menuOpen}
      aria-expanded="false"
      aria-controls="nav-drawer"
    >
      <span class="nav__burger-bar"></span>
      <span class="nav__burger-bar"></span>
      <span class="nav__burger-bar"></span>
    </button>

    <!-- Mobile drawer -->
    <div class="nav__drawer" id="nav-drawer" aria-hidden="true">
      <nav aria-label={nav.ariaLabel}>
        <ul class="nav__drawer-links" role="list">
          {links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={['nav__drawer-link', { 'nav__drawer-link--active': currentPath === href }]}
                aria-current={currentPath === href ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: var(--z-sticky);
    background-color: var(--color-bg);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  /* Logo */
  .nav__logo {
    display: flex;
    align-items: center;
  }

  .nav__logo-text {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--color-accent);
    letter-spacing: -0.01em;
  }

  /* Desktop links */
  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    list-style: none;
  }

  .nav__link {
    font-family: var(--font-body);
    font-weight: 400;
    font-style: normal;
    font-size: var(--text-sm);
    color: var(--color-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
    transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .nav__link:hover {
    color: var(--color-ink);
  }

  .nav__link--active {
    color: var(--color-ink);
    border-bottom-color: var(--color-accent);
  }

  /* Mobile burger */
  .nav__burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: var(--space-2);
    background: none;
    border: none;
  }

  .nav__burger-bar {
    display: block;
    width: 24px;
    height: 1px;
    background-color: var(--color-ink);
    transition: transform var(--duration-fast) var(--ease-out-expo),
                opacity var(--duration-fast) ease;
  }

  /* Burger → X when open */
  .nav__burger[aria-expanded="true"] .nav__burger-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .nav__burger[aria-expanded="true"] .nav__burger-bar:nth-child(2) {
    opacity: 0;
  }
  .nav__burger[aria-expanded="true"] .nav__burger-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile drawer */
  .nav__drawer {
    display: none;
  }

  @media (max-width: 640px) {
    .nav__links {
      display: none;
    }

    .nav__burger {
      display: flex;
    }

    .nav__drawer {
      display: block;
      position: fixed;
      inset: 4rem 0 0 0;
      background-color: var(--color-bg);
      border-top: var(--border-width) solid var(--color-border);
      transform: translateX(100%);
      transition: transform var(--duration-base) var(--ease-out-expo);
      z-index: var(--z-modal);
      padding: var(--space-8) var(--container-pad);
    }

    .nav__drawer.is-open {
      transform: translateX(0);
    }

    .nav__drawer-links {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    .nav__drawer-link {
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      font-weight: 800;
      color: var(--color-ink);
      transition: color var(--duration-fast) ease;
    }

    .nav__drawer-link--active {
      color: var(--color-accent);
    }

    .nav__drawer-link:hover:not(.nav__drawer-link--active) {
      color: var(--color-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__drawer,
    .nav__burger-bar,
    .nav__link {
      transition: none;
    }
  }
</style>

<script>
  const burger = document.getElementById('nav-burger')!
  const drawer = document.getElementById('nav-drawer')!

  burger.addEventListener('click', () => {
    const isOpen = burger.getAttribute('aria-expanded') === 'true'
    burger.setAttribute('aria-expanded', String(!isOpen))
    burger.setAttribute('aria-label', isOpen ? burger.getAttribute('aria-label')! : '')
    drawer.classList.toggle('is-open', !isOpen)
    drawer.setAttribute('aria-hidden', String(isOpen))
  })

  // Close on nav link click
  drawer.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      burger.setAttribute('aria-expanded', 'false')
      drawer.classList.remove('is-open')
      drawer.setAttribute('aria-hidden', 'true')
    })
  })

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
      burger.setAttribute('aria-expanded', 'false')
      drawer.classList.remove('is-open')
      drawer.setAttribute('aria-hidden', 'true')
      burger.focus()
    }
  })
</script>
