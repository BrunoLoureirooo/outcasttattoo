---
/**
 * Footer.astro — site-wide footer
 */
import ChainDivider from '@/components/shared/ChainDivider.astro'
import { strings } from '@/content/strings.pt.ts'

const { footer, jsonLd } = strings
const year = new Date().getFullYear()
---

<footer class="footer" role="contentinfo">
  <div class="footer__divider container">
    <ChainDivider />
  </div>
  <div class="footer__inner container">
    <div class="footer__brand">
      <p class="footer__name">{strings.meta.siteName}</p>
      <p class="footer__tagline">{footer.tagline}</p>
    </div>

    <div class="footer__info">
      <address class="footer__address">
        {footer.address}
      </address>
      <div class="footer__hours">
        <p>{footer.hours.label}</p>
        <p>{footer.hours.weekdays}</p>
        <p>{footer.hours.saturday}</p>
      </div>
    </div>

    <div class="footer__social">
      <a
        href={jsonLd.instagram}
        class="footer__instagram"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${strings.meta.siteName} no ${footer.instagram}`}
      >
        {footer.instagram}
      </a>
    </div>
  </div>

  <div class="footer__bottom container">
    <p class="footer__copyright">
      {footer.copyright.replace('{year}', String(year))}
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-bottom: var(--space-8);
    margin-top: var(--section-pad);
  }

  /* Chain motif replaces the plain border — quiet, structural */
  .footer__divider {
    margin-bottom: var(--space-12);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .footer__name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .footer__tagline {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .footer__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer__address {
    font-style: normal;
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.6;
  }

  .footer__hours {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.8;
  }

  .footer__hours p:first-child {
    color: var(--color-ink);
    font-weight: 700;
    margin-bottom: var(--space-1);
  }

  .footer__social {
    display: flex;
    align-items: flex-start;
  }

  .footer__instagram {
    font-size: var(--text-sm);
    color: var(--color-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color var(--duration-fast) ease;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-border);
  }

  .footer__instagram:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .footer__bottom {
    padding-top: var(--space-6);
  }

  .footer__copyright {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
</style>
