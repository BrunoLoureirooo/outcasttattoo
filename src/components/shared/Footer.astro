---
/**
 * Footer.astro — site-wide footer
 */
import ChainDivider from '@/components/shared/ChainDivider.astro'
import { strings } from '@/content/strings.pt.ts'

const { footer, jsonLd } = strings
const year = new Date().getFullYear()
---

<footer class="footer" role="contentinfo">
  <div class="footer__divider container">
    <ChainDivider />
  </div>
  <div class="footer__inner container">
    <div class="footer__brand">
      <p class="footer__name">{strings.meta.siteName}</p>
      <p class="footer__tagline">{footer.tagline}</p>
    </div>

    <div class="footer__col">
      <p class="footer__label">{footer.addressLabel}</p>
      <address class="footer__address">
        {footer.address.split('\n').map(line => <span class="footer__address-line">{line}</span>)}
      </address>
    </div>

    <div class="footer__col">
      <p class="footer__label">{footer.hours.label}</p>
      <p class="footer__line">{footer.hours.weekdays}</p>
      <p class="footer__line">{footer.hours.saturday}</p>
    </div>

    <div class="footer__col footer__col--social">
      <p class="footer__label">{footer.social}</p>
      <a
        href={jsonLd.instagram}
        class="footer__social-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${strings.meta.siteName} no ${footer.instagram}`}
      >
        {footer.instagram}
      </a>
      <a
        href={jsonLd.tiktok}
        class="footer__social-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${strings.meta.siteName} no ${footer.tiktok}`}
      >
        {footer.tiktok}
      </a>
    </div>
  </div>

  <div class="footer__bottom container">
    <p class="footer__copyright">
      {footer.copyright.replace('{year}', String(year))}
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-bottom: var(--space-8);
    margin-top: var(--section-pad);
  }

  /* Chain motif replaces the plain border — quiet, structural */
  .footer__divider {
    margin-bottom: var(--space-12);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  /* Four columns of equal grammar: brand widest, social pinned to the right
     edge mirroring the brand on the left */
  @media (min-width: 700px) {
    .footer__inner {
      grid-template-columns: 1.6fr 1fr 1fr auto;
      gap: var(--space-12);
      align-items: start;
    }
  }

  .footer__name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .footer__tagline {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* Shared column label — same top rhythm on every column */
  .footer__label {
    font-size: var(--text-xs);
    color: var(--color-ink);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-1);
  }

  .footer__address {
    font-style: normal;
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.7;
  }

  .footer__address-line {
    display: block;
  }

  .footer__line {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.7;
  }

  @media (min-width: 700px) {
    .footer__col--social {
      justify-self: end;
      align-items: flex-end;
      text-align: right;
    }
  }

  .footer__social-link {
    font-size: var(--text-sm);
    color: var(--color-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color var(--duration-fast) ease;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-border);
  }

  .footer__social-link:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .footer__bottom {
    padding-top: var(--space-6);
  }

  .footer__copyright {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
</style>
