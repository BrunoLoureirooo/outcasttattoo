---
import { strings } from '@/content/strings.pt.ts'
import artists from '@/data/artists.json'

const { marcar } = strings
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID ?? 'PLACEHOLDER'
const formspreeUrl = `https://formspree.io/f/${formspreeId}`
---

<section class="booking" aria-labelledby="booking-heading">
  <div class="container">
    <header class="booking__header">
      <h1 id="booking-heading" class="booking__heading">{marcar.heading}</h1>
      <p class="booking__intro">{marcar.intro}</p>
    </header>

    <form
      class="booking-form"
      id="booking-form"
      action={formspreeUrl}
      method="POST"
      novalidate
    >
      <!-- Honeypot -->
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
      <input type="hidden" name="_subject" value="Nova marcação — Outcast Tattoo" />

      <!-- Hidden state carriers (JS populates before submit) -->
      <input type="hidden" name="servico" id="f-service" />
      <input type="hidden" name="artista_tatuagem" id="f-artist-tattoo" />
      <input type="hidden" name="artista_piercing" id="f-artist-piercing" />
      <input type="hidden" name="zonas_tatuagem" id="f-body-areas" />
      <input type="hidden" name="zonas_piercing" id="f-piercing-areas" />
      <input type="hidden" name="tamanho" id="f-size" />

      <!-- ── Step 1: Service toggle ────────────────────────────── -->
      <fieldset class="step step--service" id="step-service">
        <legend class="step__label">{marcar.services.label}</legend>
        <div class="service-toggles">
          <button type="button" class="service-btn" data-service="tattoo" aria-pressed="false">
            {marcar.services.tattoo}
          </button>
          <button type="button" class="service-btn" data-service="piercing" aria-pressed="false">
            {marcar.services.piercing}
          </button>
        </div>
      </fieldset>

      <!-- ── Step 2: Artist selection ──────────────────────────── -->
      <div class="step step--artists" id="step-artists" hidden>

        <!-- Tattoo artist picker -->
        <div class="artist-picker" data-picker="tattoo" hidden>
          <p class="step__label">{marcar.artistTattoo.label}</p>
          <div class="artist-cards" role="group" aria-label={marcar.artistTattoo.label}>
            {artists.map(a => (
              <button
                type="button"
                class="artist-pick-card"
                data-artist-id={a.id}
                data-artist-name={a.name}
                data-services={a.services.join(',')}
                data-picker-target="tattoo"
                aria-pressed="false"
                aria-label={a.name}
              >
                <span class="artist-pick-card__avatar" aria-hidden="true">{a.name.charAt(0)}</span>
                <div class="artist-pick-card__details">
                  <span class="artist-pick-card__name">{a.name}</span>
                  <div class="artist-pick-card__tags">
                    {a.services.map(s => (
                      <span class="artist-pick-card__tag">{s === 'tattoo' ? marcar.services.tattoo : marcar.services.piercing}</span>
                    ))}
                  </div>
                </div>
              </button>
            ))}
            <button
              type="button"
              class="artist-pick-card artist-pick-card--dice"
              data-artist-id="no-preference"
              data-artist-name={marcar.noPreference}
              data-services="tattoo,piercing"
              data-picker-target="tattoo"
              aria-pressed="false"
              aria-label={marcar.noPreference}
            >
              <span class="artist-pick-card__avatar" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.2" fill="currentColor" stroke="none"/>
                  <circle cx="15.5" cy="8.5" r="1.2" fill="currentColor" stroke="none"/>
                  <circle cx="8.5" cy="15.5" r="1.2" fill="currentColor" stroke="none"/>
                  <circle cx="15.5" cy="15.5" r="1.2" fill="currentColor" stroke="none"/>
                  <circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"/>
                </svg>
              </span>
              <div class="artist-pick-card__details">
                <span class="artist-pick-card__name">{marcar.noPreference}</span>
              </div>
            </button>
          </div>
        </div>

        <!-- Piercing artist picker -->
        <div class="artist-picker" data-picker="piercing" hidden>
          <p class="step__label">{marcar.artistPiercing.label}</p>
          <div class="artist-cards" role="group" aria-label={marcar.artistPiercing.label}>
            {artists.map(a => (
              <button
                type="button"
                class="artist-pick-card"
                data-artist-id={a.id}
                data-artist-name={a.name}
                data-services={a.services.join(',')}
                data-picker-target="piercing"
                aria-pressed="false"
                aria-label={a.name}
              >
                <span class="artist-pick-card__avatar" aria-hidden="true">{a.name.charAt(0)}</span>
                <div class="artist-pick-card__details">
                  <span class="artist-pick-card__name">{a.name}</span>
                  <div class="artist-pick-card__tags">
                    {a.services.map(s => (
                      <span class="artist-pick-card__tag">{s === 'tattoo' ? marcar.services.tattoo : marcar.services.piercing}</span>
                    ))}
                  </div>
                </div>
              </button>
            ))}
            <button
              type="button"
              class="artist-pick-card artist-pick-card--dice"
              data-artist-id="no-preference"
              data-artist-name={marcar.noPreference}
              data-services="tattoo,piercing"
              data-picker-target="piercing"
              aria-pressed="false"
              aria-label={marcar.noPreference}
            >
              <span class="artist-pick-card__avatar" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.2" fill="currentColor" stroke="none"/>
                  <circle cx="15.5" cy="8.5" r="1.2" fill="currentColor" stroke="none"/>
                  <circle cx="8.5" cy="15.5" r="1.2" fill="currentColor" stroke="none"/>
                  <circle cx="15.5" cy="15.5" r="1.2" fill="currentColor" stroke="none"/>
                  <circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"/>
                </svg>
              </span>
              <div class="artist-pick-card__details">
                <span class="artist-pick-card__name">{marcar.noPreference}</span>
              </div>
            </button>
          </div>
        </div>

      </div>

      <!-- ── Step 3a: Body area selector (tattoo) ───────────────── -->
      <fieldset class="step step--body-area" id="step-body" hidden>
        <legend class="step__label">{marcar.bodyArea.label}</legend>
        <div class="body-selector">
          <!-- Front silhouette -->
          <div class="body-map">
            <svg viewBox="0 0 120 270" xmlns="http://www.w3.org/2000/svg" class="body-map__svg" aria-hidden="true">
              <ellipse data-area="head" data-label="Cabeça"
                cx="60" cy="25" rx="18" ry="22"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Cabeça" />
              <rect data-area="neck" data-label="Pescoço"
                x="53" y="46" width="14" height="12" rx="2"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Pescoço" />
              <ellipse data-area="chest" data-label="Peito"
                cx="60" cy="78" rx="28" ry="20"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Peito" />
              <ellipse data-area="abdomen" data-label="Abdómen"
                cx="60" cy="114" rx="22" ry="18"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Abdómen" />
              <!-- Arms split: upper arm + forearm -->
              <rect data-area="upper-arm-left" data-label="Braço esquerdo (superior)"
                x="14" y="60" width="15" height="34" rx="7"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Braço esquerdo superior" />
              <rect data-area="forearm-left" data-label="Antebraço esquerdo"
                x="14" y="96" width="15" height="32" rx="7"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Antebraço esquerdo" />
              <rect data-area="upper-arm-right" data-label="Braço direito (superior)"
                x="91" y="60" width="15" height="34" rx="7"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Braço direito superior" />
              <rect data-area="forearm-right" data-label="Antebraço direito"
                x="91" y="96" width="15" height="32" rx="7"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Antebraço direito" />
              <!-- Legs: thigh + calf, 2px gap at knee -->
              <rect data-area="thigh-left" data-label="Coxa esquerda"
                x="34" y="132" width="20" height="55" rx="10"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Coxa esquerda" />
              <rect data-area="calf-left" data-label="Canela esquerda"
                x="34" y="189" width="20" height="62" rx="10"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Canela esquerda" />
              <rect data-area="thigh-right" data-label="Coxa direita"
                x="66" y="132" width="20" height="55" rx="10"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Coxa direita" />
              <rect data-area="calf-right" data-label="Canela direita"
                x="66" y="189" width="20" height="62" rx="10"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Canela direita" />
            </svg>
            <span class="body-map__label">Frente</span>
          </div>
          <!-- Back silhouette -->
          <div class="body-map">
            <svg viewBox="0 0 120 270" xmlns="http://www.w3.org/2000/svg" class="body-map__svg" aria-hidden="true">
              <ellipse data-area="head-back" data-label="Cabeça (costas)"
                cx="60" cy="25" rx="18" ry="22"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Cabeça (costas)" />
              <ellipse data-area="upper-back" data-label="Costas superiores"
                cx="60" cy="78" rx="28" ry="20"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Costas superiores" />
              <ellipse data-area="lower-back" data-label="Costas inferiores"
                cx="60" cy="114" rx="22" ry="18"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Costas inferiores" />
              <rect data-area="upper-arm-left-back" data-label="Braço esquerdo superior (costas)"
                x="14" y="60" width="15" height="34" rx="7"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Braço esquerdo superior (costas)" />
              <rect data-area="forearm-left-back" data-label="Antebraço esquerdo (costas)"
                x="14" y="96" width="15" height="32" rx="7"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Antebraço esquerdo (costas)" />
              <rect data-area="upper-arm-right-back" data-label="Braço direito superior (costas)"
                x="91" y="60" width="15" height="34" rx="7"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Braço direito superior (costas)" />
              <rect data-area="forearm-right-back" data-label="Antebraço direito (costas)"
                x="91" y="96" width="15" height="32" rx="7"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Antebraço direito (costas)" />
              <rect data-area="ham-left" data-label="Isquiotibial esquerdo"
                x="34" y="132" width="20" height="55" rx="10"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Isquiotibial esquerdo" />
              <rect data-area="gemeo-left" data-label="Gémeo esquerdo"
                x="34" y="189" width="20" height="62" rx="10"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Gémeo esquerdo" />
              <rect data-area="ham-right" data-label="Isquiotibial direito"
                x="66" y="132" width="20" height="55" rx="10"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Isquiotibial direito" />
              <rect data-area="gemeo-right" data-label="Gémeo direito"
                x="66" y="189" width="20" height="62" rx="10"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Gémeo direito" />
            </svg>
            <span class="body-map__label">Costas</span>
          </div>
        </div>
        <p class="body-area-display" id="body-area-display" aria-live="polite">
          {marcar.bodyArea.placeholder}
        </p>
      </fieldset>

      <!-- ── Step 3b: Piercing selector ────────────────────────── -->
      <fieldset class="step step--piercing" id="step-piercing" hidden>
        <legend class="step__label">{marcar.piercingArea.label}</legend>

        <!-- Tab navigation -->
        <div class="piercing-tabs" role="tablist">
          <button type="button" class="piercing-tab piercing-tab--active"
            role="tab" aria-selected="true" aria-controls="piercing-panel-ear" id="tab-ear">
            {marcar.piercingArea.ear}
          </button>
          <button type="button" class="piercing-tab"
            role="tab" aria-selected="false" aria-controls="piercing-panel-body" id="tab-body">
            {marcar.piercingArea.body}
          </button>
        </div>

        <!-- Ear panel -->
        <div class="piercing-panel" id="piercing-panel-ear" role="tabpanel" aria-labelledby="tab-ear">
          <div class="ear-pair">

            <!-- LEFT EAR -->
            <div class="ear-wrap">
              <svg viewBox="0 0 160 290" xmlns="http://www.w3.org/2000/svg" class="ear-svg" aria-hidden="true">
                <!-- Outer helix — main ear silhouette -->
                <path d="M 92,18 C 126,12 150,42 150,82 C 150,122 140,156 126,180 C 110,206 86,224 60,230 C 38,236 18,230 10,216 C 0,200 2,180 10,168 C 18,156 36,152 44,143 C 52,134 52,118 46,98 C 38,74 36,48 48,30 C 58,15 76,12 92,18 Z"
                  fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="2"/>
                <!-- Inner helix rim -->
                <path d="M 92,28 C 118,24 138,48 138,82 C 138,108 132,132 120,154"
                  fill="none" stroke="var(--color-border)" stroke-width="1.3"/>
                <!-- Anti-helix trunk -->
                <path d="M 86,54 C 104,48 114,66 112,88 C 110,104 100,116 88,126 C 84,132 80,140 78,150"
                  fill="none" stroke="var(--color-border)" stroke-width="1.3"/>
                <!-- Anti-helix superior crus -->
                <path d="M 88,126 C 92,136 94,150 88,162"
                  fill="none" stroke="var(--color-border)" stroke-width="1.2"/>
                <!-- Concha bowl -->
                <ellipse cx="74" cy="164" rx="20" ry="26" fill="none" stroke="var(--color-border)" stroke-width="1.3"/>
                <!-- Tragus -->
                <path d="M 28,150 C 22,140 22,126 28,118 C 34,110 48,112 50,122"
                  fill="none" stroke="var(--color-border)" stroke-width="1.8" stroke-linecap="round"/>
                <!-- Lobe inner curve -->
                <path d="M 10,184 C 6,198 10,214 22,222"
                  fill="none" stroke="var(--color-border)" stroke-width="1.2"/>

                <!-- PIERCING POINTS -->
                <circle cx="132" cy="48"  r="6" class="piercing-point" data-piercing="helix-sup-left"    data-label="Hélix superior (esq.)"  role="checkbox" aria-checked="false" tabindex="0" aria-label="Hélix superior esquerda"/>
                <circle cx="140" cy="84"  r="6" class="piercing-point" data-piercing="helix-mid-left"    data-label="Hélix médio (esq.)"     role="checkbox" aria-checked="false" tabindex="0" aria-label="Hélix médio esquerda"/>
                <circle cx="130" cy="122" r="6" class="piercing-point" data-piercing="helix-inf-left"    data-label="Hélix inferior (esq.)"  role="checkbox" aria-checked="false" tabindex="0" aria-label="Hélix inferior esquerda"/>
                <circle cx="86"  cy="54"  r="6" class="piercing-point" data-piercing="rook-left"         data-label="Rook (esq.)"            role="checkbox" aria-checked="false" tabindex="0" aria-label="Rook esquerda"/>
                <circle cx="104" cy="80"  r="6" class="piercing-point" data-piercing="anti-helix-left"   data-label="Anti-hélix (esq.)"      role="checkbox" aria-checked="false" tabindex="0" aria-label="Anti-hélix esquerda"/>
                <circle cx="74"  cy="142" r="6" class="piercing-point" data-piercing="daith-left"        data-label="Daith (esq.)"           role="checkbox" aria-checked="false" tabindex="0" aria-label="Daith esquerda"/>
                <circle cx="74"  cy="164" r="6" class="piercing-point" data-piercing="concha-left"       data-label="Concha (esq.)"          role="checkbox" aria-checked="false" tabindex="0" aria-label="Concha esquerda"/>
                <circle cx="32"  cy="134" r="6" class="piercing-point" data-piercing="tragus-left"       data-label="Trágus (esq.)"          role="checkbox" aria-checked="false" tabindex="0" aria-label="Trágus esquerda"/>
                <circle cx="70"  cy="174" r="6" class="piercing-point" data-piercing="anti-tragus-left"  data-label="Anti-trágus (esq.)"     role="checkbox" aria-checked="false" tabindex="0" aria-label="Anti-trágus esquerda"/>
                <circle cx="52"  cy="220" r="6" class="piercing-point" data-piercing="lobulo-left"       data-label="Lóbulo (esq.)"          role="checkbox" aria-checked="false" tabindex="0" aria-label="Lóbulo esquerda"/>
              </svg>
              <span class="ear-label">Esquerda</span>
            </div>

            <!-- RIGHT EAR (mirror) -->
            <div class="ear-wrap">
              <svg viewBox="0 0 160 290" xmlns="http://www.w3.org/2000/svg" class="ear-svg" aria-hidden="true">
                <!-- Outer helix — mirrored -->
                <path d="M 68,18 C 34,12 10,42 10,82 C 10,122 20,156 34,180 C 50,206 74,224 100,230 C 122,236 142,230 150,216 C 160,200 158,180 150,168 C 142,156 124,152 116,143 C 108,134 108,118 114,98 C 122,74 124,48 112,30 C 102,15 84,12 68,18 Z"
                  fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="2"/>
                <!-- Inner helix rim -->
                <path d="M 68,28 C 42,24 22,48 22,82 C 22,108 28,132 40,154"
                  fill="none" stroke="var(--color-border)" stroke-width="1.3"/>
                <!-- Anti-helix trunk -->
                <path d="M 74,54 C 56,48 46,66 48,88 C 50,104 60,116 72,126 C 76,132 80,140 82,150"
                  fill="none" stroke="var(--color-border)" stroke-width="1.3"/>
                <!-- Anti-helix superior crus -->
                <path d="M 72,126 C 68,136 66,150 72,162"
                  fill="none" stroke="var(--color-border)" stroke-width="1.2"/>
                <!-- Concha bowl -->
                <ellipse cx="86" cy="164" rx="20" ry="26" fill="none" stroke="var(--color-border)" stroke-width="1.3"/>
                <!-- Tragus -->
                <path d="M 132,150 C 138,140 138,126 132,118 C 126,110 112,112 110,122"
                  fill="none" stroke="var(--color-border)" stroke-width="1.8" stroke-linecap="round"/>
                <!-- Lobe inner curve -->
                <path d="M 150,184 C 154,198 150,214 138,222"
                  fill="none" stroke="var(--color-border)" stroke-width="1.2"/>

                <!-- PIERCING POINTS (mirrored) -->
                <circle cx="28"  cy="48"  r="6" class="piercing-point" data-piercing="helix-sup-right"   data-label="Hélix superior (dir.)"  role="checkbox" aria-checked="false" tabindex="0" aria-label="Hélix superior direita"/>
                <circle cx="20"  cy="84"  r="6" class="piercing-point" data-piercing="helix-mid-right"   data-label="Hélix médio (dir.)"     role="checkbox" aria-checked="false" tabindex="0" aria-label="Hélix médio direita"/>
                <circle cx="30"  cy="122" r="6" class="piercing-point" data-piercing="helix-inf-right"   data-label="Hélix inferior (dir.)"  role="checkbox" aria-checked="false" tabindex="0" aria-label="Hélix inferior direita"/>
                <circle cx="74"  cy="54"  r="6" class="piercing-point" data-piercing="rook-right"        data-label="Rook (dir.)"            role="checkbox" aria-checked="false" tabindex="0" aria-label="Rook direita"/>
                <circle cx="56"  cy="80"  r="6" class="piercing-point" data-piercing="anti-helix-right"  data-label="Anti-hélix (dir.)"      role="checkbox" aria-checked="false" tabindex="0" aria-label="Anti-hélix direita"/>
                <circle cx="86"  cy="142" r="6" class="piercing-point" data-piercing="daith-right"       data-label="Daith (dir.)"           role="checkbox" aria-checked="false" tabindex="0" aria-label="Daith direita"/>
                <circle cx="86"  cy="164" r="6" class="piercing-point" data-piercing="concha-right"      data-label="Concha (dir.)"          role="checkbox" aria-checked="false" tabindex="0" aria-label="Concha direita"/>
                <circle cx="128" cy="134" r="6" class="piercing-point" data-piercing="tragus-right"      data-label="Trágus (dir.)"          role="checkbox" aria-checked="false" tabindex="0" aria-label="Trágus direita"/>
                <circle cx="90"  cy="174" r="6" class="piercing-point" data-piercing="anti-tragus-right" data-label="Anti-trágus (dir.)"     role="checkbox" aria-checked="false" tabindex="0" aria-label="Anti-trágus direita"/>
                <circle cx="108" cy="220" r="6" class="piercing-point" data-piercing="lobulo-right"      data-label="Lóbulo (dir.)"          role="checkbox" aria-checked="false" tabindex="0" aria-label="Lóbulo direita"/>
              </svg>
              <span class="ear-label">Direita</span>
            </div>

          </div>
        </div>

        <!-- Body panel -->
        <div class="piercing-panel" id="piercing-panel-body" role="tabpanel" aria-labelledby="tab-body" hidden>
          <svg viewBox="0 0 200 320" xmlns="http://www.w3.org/2000/svg" class="piercing-svg" aria-hidden="true">
            <!-- Head outline -->
            <ellipse cx="100" cy="60" rx="38" ry="48" fill="none" stroke="var(--color-border)" stroke-width="1.5"/>
            <!-- Neck -->
            <rect x="90" y="106" width="20" height="20" rx="4" fill="none" stroke="var(--color-border)" stroke-width="1.5"/>
            <!-- Torso -->
            <path d="M 65,126 L 135,126 L 145,220 L 145,290 L 55,290 L 55,220 Z" fill="none" stroke="var(--color-border)" stroke-width="1.5"/>
            <!-- Arms (simplified) -->
            <rect x="30" y="126" width="28" height="90" rx="12" fill="none" stroke="var(--color-border)" stroke-width="1.5"/>
            <rect x="142" y="126" width="28" height="90" rx="12" fill="none" stroke="var(--color-border)" stroke-width="1.5"/>

            <!-- Face piercing points -->
            <!-- Sobrancelha esquerda -->
            <circle cx="80" cy="45" r="6" class="piercing-point" data-piercing="eyebrow-left" data-label="Sobrancelha esquerda" role="checkbox" aria-checked="false" tabindex="0" aria-label="Sobrancelha esquerda"/>
            <!-- Sobrancelha direita -->
            <circle cx="120" cy="45" r="6" class="piercing-point" data-piercing="eyebrow-right" data-label="Sobrancelha direita" role="checkbox" aria-checked="false" tabindex="0" aria-label="Sobrancelha direita"/>
            <!-- Narina esquerda -->
            <circle cx="88" cy="78" r="6" class="piercing-point" data-piercing="nostril-left" data-label="Narina esquerda" role="checkbox" aria-checked="false" tabindex="0" aria-label="Narina esquerda"/>
            <!-- Septo -->
            <circle cx="100" cy="84" r="6" class="piercing-point" data-piercing="septum" data-label="Septo" role="checkbox" aria-checked="false" tabindex="0" aria-label="Septo"/>
            <!-- Narina direita -->
            <circle cx="112" cy="78" r="6" class="piercing-point" data-piercing="nostril-right" data-label="Narina direita" role="checkbox" aria-checked="false" tabindex="0" aria-label="Narina direita"/>
            <!-- Labret -->
            <circle cx="100" cy="100" r="6" class="piercing-point" data-piercing="labret" data-label="Labret" role="checkbox" aria-checked="false" tabindex="0" aria-label="Labret"/>

            <!-- Body piercing points -->
            <!-- Mamilo esquerdo -->
            <circle cx="78" cy="168" r="6" class="piercing-point" data-piercing="nipple-left" data-label="Mamilo esquerdo" role="checkbox" aria-checked="false" tabindex="0" aria-label="Mamilo esquerdo"/>
            <!-- Mamilo direito -->
            <circle cx="122" cy="168" r="6" class="piercing-point" data-piercing="nipple-right" data-label="Mamilo direito" role="checkbox" aria-checked="false" tabindex="0" aria-label="Mamilo direito"/>
            <!-- Umbigo -->
            <circle cx="100" cy="228" r="6" class="piercing-point" data-piercing="navel" data-label="Umbigo" role="checkbox" aria-checked="false" tabindex="0" aria-label="Umbigo"/>
          </svg>
        </div>

        <p class="body-area-display" id="piercing-area-display" aria-live="polite">
          {marcar.piercingArea.placeholder}
        </p>
      </fieldset>

      <!-- ── Step 3c: Size selector (tattoo only) ─────────────── -->
      <div class="step step--size" id="step-size" hidden>
        <p class="step__label">{marcar.size.label} <span class="optional">opcional</span></p>
        <div class="size-btns">
          <button type="button" class="size-btn" data-size={marcar.size.small.label} aria-pressed="false">
            <span class="size-btn__label">{marcar.size.small.label}</span>
            <span class="size-btn__ref">{marcar.size.small.ref}</span>
          </button>
          <button type="button" class="size-btn" data-size={marcar.size.medium.label} aria-pressed="false">
            <span class="size-btn__label">{marcar.size.medium.label}</span>
            <span class="size-btn__ref">{marcar.size.medium.ref}</span>
          </button>
          <button type="button" class="size-btn" data-size={marcar.size.large.label} aria-pressed="false">
            <span class="size-btn__label">{marcar.size.large.label}</span>
            <span class="size-btn__ref">{marcar.size.large.ref}</span>
          </button>
        </div>
      </div>

      <!-- ── Step 4: Reference link ──────────────────────────────── -->
      <div class="step step--field" id="step-reference" hidden>
        <label class="step__label" for="reference-link">
          {marcar.referenceLink.label} <span class="optional">opcional</span>
        </label>
        <input
          type="url"
          class="form-input"
          id="reference-link"
          name="referencia"
          placeholder={marcar.referenceLink.placeholder}
          autocomplete="off"
        />
      </div>

      <!-- ── Step 5: Description ─────────────────────────────────── -->
      <div class="step step--field" id="step-description" hidden>
        <label class="step__label" for="description">
          {marcar.description.label}
        </label>
        <textarea
          class="form-textarea"
          id="description"
          name="descricao"
          rows="5"
          placeholder={marcar.description.placeholder}
          required
          aria-required="true"
        ></textarea>
      </div>

      <!-- ── Step 6: Contact ────────────────────────────────────── -->
      <div class="step step--contact" id="step-contact" hidden>
        <div class="contact-row">
          <div class="contact-field">
            <label class="step__label" for="contact-name">{marcar.contact.nameLabel}</label>
            <input
              type="text"
              class="form-input"
              id="contact-name"
              name="nome"
              placeholder={marcar.contact.namePlaceholder}
              required
              aria-required="true"
              autocomplete="name"
            />
          </div>
          <div class="contact-field">
            <label class="step__label" for="contact-email">{marcar.contact.emailLabel}</label>
            <input
              type="email"
              class="form-input"
              id="contact-email"
              name="email"
              placeholder={marcar.contact.emailPlaceholder}
              required
              aria-required="true"
              autocomplete="email"
            />
          </div>
          <div class="contact-field">
            <label class="step__label" for="contact-phone">{marcar.contact.phoneLabel} <span class="optional">opcional</span></label>
            <input
              type="tel"
              class="form-input"
              id="contact-phone"
              name="telemovel"
              placeholder={marcar.contact.phonePlaceholder}
              autocomplete="tel"
            />
          </div>
        </div>
      </div>

      <!-- ── Submit ──────────────────────────────────────────────── -->
      <div class="step step--submit" id="step-submit" hidden>
        <button type="submit" class="submit-btn" id="submit-btn">
          {marcar.submit}
        </button>
        <p class="form-disclaimer">{marcar.disclaimer}</p>
      </div>

      <!-- Success / Error states -->
      <div class="form-success" id="form-success" hidden aria-live="polite">
        <p>{marcar.success}</p>
      </div>
      <div class="form-error" id="form-error" hidden aria-live="polite">
        <p>{marcar.error}</p>
      </div>
    </form>
  </div>
</section>

<style>
  .booking {
    padding-block: var(--section-pad);
  }

  .booking__header {
    margin-bottom: var(--space-16);
  }

  .booking__heading {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 900;
    color: var(--color-ink);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }

  .booking__intro {
    font-size: var(--text-lg);
    color: var(--color-muted);
