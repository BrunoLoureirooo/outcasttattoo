          {marcar.piercingArea.placeholder}
        </p>
      </fieldset>

      <!-- ── Step 3c: Size selector (tattoo only) ─────────────── -->
      <div class="step step--size" id="step-size" hidden>
        <p class="step__label">{marcar.size.label} <span class="optional">{common.optional}</span></p>
        <div class="size-btns">
          <button type="button" class="size-btn" data-size={marcar.size.small.label} aria-pressed="false">
            <span class="size-btn__label">{marcar.size.small.label}</span>
            <span class="size-btn__ref">{marcar.size.small.ref}</span>
          </button>
          <button type="button" class="size-btn" data-size={marcar.size.medium.label} aria-pressed="false">
            <span class="size-btn__label">{marcar.size.medium.label}</span>
            <span class="size-btn__ref">{marcar.size.medium.ref}</span>
          </button>
          <button type="button" class="size-btn" data-size={marcar.size.large.label} aria-pressed="false">
            <span class="size-btn__label">{marcar.size.large.label}</span>
            <span class="size-btn__ref">{marcar.size.large.ref}</span>
          </button>
        </div>
      </div>

      <!-- ── Step 4: Reference link ──────────────────────────────── -->
      <div class="step step--field" id="step-reference" hidden>
        <label class="step__label" for="reference-link">
          {marcar.referenceLink.label} <span class="optional">{common.optional}</span>
        </label>
        <input
          type="url"
          class="form-input"
          id="reference-link"
          name="referencia"
          placeholder={marcar.referenceLink.placeholder}
          autocomplete="off"
        />
      </div>

      <!-- ── Step 5: Description ─────────────────────────────────── -->
      <div class="step step--field" id="step-description" hidden>
        <label class="step__label" for="description">
          {marcar.description.label}
        </label>
        <textarea
          class="form-textarea"
          id="description"
          name="descricao"
          rows="5"
          placeholder={marcar.description.placeholder}
          required
          aria-required="true"
        ></textarea>
      </div>

      <!-- ── Step 6: Contact ────────────────────────────────────── -->
      <div class="step step--contact" id="step-contact" hidden>
        <div class="contact-row">
          <div class="contact-field">
            <label class="step__label" for="contact-name">{marcar.contact.nameLabel}</label>
            <input
              type="text"
              class="form-input"
              id="contact-name"
              name="nome"
              placeholder={marcar.contact.namePlaceholder}
              required
              aria-required="true"
              autocomplete="name"
            />
          </div>
          <div class="contact-field">
            <label class="step__label" for="contact-email">{marcar.contact.emailLabel}</label>
            <input
              type="email"
              class="form-input"
              id="contact-email"
              name="email"
              placeholder={marcar.contact.emailPlaceholder}
              required
              aria-required="true"
              autocomplete="email"
            />
          </div>
          <div class="contact-field">
            <label class="step__label" for="contact-phone">{marcar.contact.phoneLabel} <span class="optional">{common.optional}</span></label>
            <input
              type="tel"
              class="form-input"
              id="contact-phone"
              name="telemovel"
              placeholder={marcar.contact.phonePlaceholder}
              autocomplete="tel"
            />
          </div>
        </div>
      </div>

      <!-- ── Submit ──────────────────────────────────────────────── -->
      <div class="step step--submit" id="step-submit" hidden>
        <button type="submit" class="submit-btn" id="submit-btn">
          {marcar.submit}
        </button>
        <p class="form-disclaimer">{marcar.disclaimer}</p>
      </div>

      <!-- Success / Error / Validation states -->
      <div class="form-success" id="form-success" hidden aria-live="polite">
        <p>{marcar.success}</p>
      </div>
      <div class="form-error" id="form-error" hidden aria-live="polite">
        <p>{marcar.error}</p>
      </div>
      <div class="form-error" id="form-validation" hidden aria-live="polite">
        <p>{marcar.validation}</p>
      </div>
    </form>
  </div>
</section>

<style>
  .booking {
    padding-block: var(--section-pad);
  }

  .booking__header {
    margin-bottom: var(--space-16);
  }

  .booking__heading {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 900;
    color: var(--color-ink);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }

  .booking__intro {
    font-size: var(--text-lg);
    color: var(--color-muted);
    max-width: 50ch;
  }

  /* ── Form layout ──────────────────────────────── */

  .booking-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    border: none;
    padding: 0;
    margin: 0;
  }

  /* Steps rise in as they appear (hidden → shown); hide stays instant.
     @starting-style fires when display flips from none — graceful no-op
     in browsers without support. */
  .step:not([hidden]),
  .artist-picker:not([hidden]) {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.35s var(--ease-out-expo),
      transform 0.35s var(--ease-out-expo);
  }

  @starting-style {
    .step:not([hidden]),
    .artist-picker:not([hidden]) {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  .step__label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-1);
  }

  /* ── Service toggle buttons ───────────────────── */

  .service-toggles {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .service-btn {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-muted);
    background: transparent;
    border: var(--border-width) solid var(--color-border);
    padding: var(--space-3) var(--space-8);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }

  .service-btn[aria-pressed="true"] {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .service-btn:hover:not([aria-pressed="true"]) {
    color: var(--color-ink);
    border-color: var(--color-ink);
  }

  /* ── Artist picker — character select ────────── */

  .artist-picker {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .artist-picker + .artist-picker {
    margin-top: var(--space-12);
  }

  .artist-cards {
    display: flex;
    gap: 3px;
    height: 320px;
  }

  .artist-pick-card {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    cursor: pointer;
    padding: 0;
    transition:
      flex 0.45s var(--ease-out-expo),
      border-color var(--duration-fast) ease;
  }

  .artist-pick-card:hover:not(.dimmed) {
    flex: 5 1 0;
  }

  .artist-pick-card[aria-pressed="true"] {
    border-color: var(--color-accent);
  }

  .artist-pick-card.dimmed {
    opacity: 0.25;
    pointer-events: none;
  }

  /* Initial — main visual in narrow state, ghost in expanded state */
  .artist-pick-card__avatar {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-4xl);
    line-height: 1;
    color: var(--color-muted);
    /* font-size deliberately NOT transitioned — layout-animating text shimmers;
       the size snap is masked by the ghost fade + card expansion */
    transition:
      color 0.3s ease,
      transform 0.45s var(--ease-out-expo);
    z-index: 1;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .artist-pick-card:hover:not(.dimmed) .artist-pick-card__avatar {
    position: absolute;
    inset: 0;
    font-size: clamp(8rem, 20vw, 14rem);
    color: oklch(0.96 0 0 / 0.05);
    z-index: 0;
  }

  /* Dice card SVG avatar */
  .artist-pick-card--dice .artist-pick-card__avatar svg {
    width: clamp(28px, 4vw, 40px);
    height: clamp(28px, 4vw, 40px);
    color: var(--color-muted);
    transition: color 0.3s ease;
  }

  .artist-pick-card--dice:hover:not(.dimmed) .artist-pick-card__avatar svg {
    width: clamp(60px, 12vw, 100px);
    height: clamp(60px, 12vw, 100px);
    color: oklch(0.96 0 0 / 0.05);
  }

  /* Details — hidden in narrow state, revealed when selected */
  .artist-pick-card__details {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-5) var(--space-5) var(--space-5);
    background: var(--color-surface);
    border-top: var(--border-width) solid var(--color-border);
    z-index: 2;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.25s ease 0.2s,
      transform 0.25s ease 0.2s;
    pointer-events: none;
  }

  .artist-pick-card:hover:not(.dimmed) .artist-pick-card__details {
    opacity: 1;
    transform: none;
  }

  .artist-pick-card__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    color: var(--color-ink);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .artist-pick-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .artist-pick-card__tag {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-muted);
    border: var(--border-width) solid var(--color-border);
    padding: 1px var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  /* ── Body area selector ───────────────────────── */

  .body-selector {
    display: flex;
    gap: var(--space-8);
  }

  .body-map {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .body-map__svg {
    width: 100%;
    max-width: 130px;
  }

  .body-map__label {
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .body-silhouette > * {
    fill: var(--color-surface);
    stroke: var(--color-border);
    stroke-width: 1.5;
  }

  .body-map__area {
    fill: transparent;
    stroke: none;
    cursor: pointer;
    transition: fill var(--duration-fast) ease;
  }

  .body-map__area:hover {
    fill: oklch(from var(--color-accent) l c h / 0.22);
  }

  .body-map__area[aria-checked="true"] {
    fill: oklch(from var(--color-accent) l c h / 0.42);
  }

  .body-area-display {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-style: italic;
    margin-top: var(--space-2);
  }

  /* ── Piercing selector ────────────────────────── */

  .piercing-tabs {
    display: flex;
    gap: var(--space-2);
    border-bottom: var(--border-width) solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  .piercing-tab {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-muted);
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: var(--space-2) var(--space-4);
    margin-bottom: -1px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .piercing-tab--active,
  .piercing-tab[aria-selected="true"] {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .piercing-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .piercing-svg {
    width: 100%;
    max-width: 320px;
  }

  .ear-hint {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-style: italic;
    text-align: center;
    margin-bottom: var(--space-4);
  }

  .ear-pair {
    display: flex;
    gap: var(--space-8);
    justify-content: center;
    flex-wrap: wrap;
  }

  .ear-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .ear-svg {
    width: clamp(120px, 26vw, 190px);
    height: auto;
  }

  .ear-svg--clickable {
    cursor: crosshair;
  }

  /* Ear shape fill — override any inherited stroke */
  .ear-svg path {
    stroke: none;
  }

  /* Piercing point dots */
  .piercing-point {
    fill: var(--color-border);
    stroke: var(--color-muted);
    stroke-width: 1;
    cursor: pointer;
    transition: fill var(--duration-fast) ease, stroke var(--duration-fast) ease;
  }

  .piercing-point:hover,
  .piercing-point:focus {
    fill: var(--color-accent-dim);
    stroke: var(--color-accent);
    outline: none;
  }

  .piercing-point[aria-checked="true"] {
    fill: var(--color-accent);
    stroke: var(--color-ink);
  }

  .ear-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* Freehand pins placed by JS */
  .ear-pin {
    fill: var(--color-accent);
    stroke: var(--color-bg);
    stroke-width: 1.5;
    cursor: pointer;
    transition: fill var(--duration-fast) ease, r var(--duration-fast) ease;
  }

  .ear-pin:hover {
    fill: oklch(from var(--color-accent) l c h / 0.6);
  }

  /* ── Form fields ──────────────────────────────── */

  .form-input,
  .form-textarea {
    width: 100%;
    max-width: 600px;
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: var(--text-base);
    padding: var(--space-3) var(--space-4);
    transition: border-color var(--duration-fast) ease;
    appearance: none;
  }

  .form-input:focus,
  .form-textarea:focus {
    border-color: var(--color-accent);
    outline: none;
  }

  .form-input::placeholder,
  .form-textarea::placeholder {
    color: var(--color-muted);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  /* ── Optional label ──────────────────────────── */

  .optional {
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-transform: none;
    letter-spacing: 0;
    opacity: 0.7;
  }

  /* ── Size selector ────────────────────────────── */

  .size-btns {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .size-btn {
    flex: 1 1 140px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
    background: transparent;
    border: var(--border-width) solid var(--color-border);
    cursor: pointer;
    text-align: left;
    transition: border-color var(--duration-fast) ease;
  }

  .size-btn[aria-pressed="true"] {
    border-color: var(--color-accent);
  }

  .size-btn:hover:not([aria-pressed="true"]) {
    border-color: var(--color-muted);
  }

  .size-btn__label {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: -0.01em;
    transition: color var(--duration-fast) ease;
  }

  .size-btn[aria-pressed="true"] .size-btn__label {
    color: var(--color-accent);
  }

  .size-btn__ref {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-muted);
    letter-spacing: 0.03em;
  }

  /* ── Contact fields ──────────────────────────── */

  .contact-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--space-4);
  }

  .contact-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  @media (max-width: 640px) {
    .contact-row {
      grid-template-columns: 1fr;
    }
  }

  /* ── Submit ───────────────────────────────────── */

  .step--submit {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .submit-btn {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-accent);
    background: transparent;
    border: var(--border-width) solid var(--color-accent);
    padding: var(--space-3) var(--space-8);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out-expo),
      color var(--duration-fast) var(--ease-out-expo);
  }

  .submit-btn:hover {
    background-color: var(--color-accent);
    color: var(--color-bg);
  }

  .submit-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .form-disclaimer {
    font-size: var(--text-xs);
    color: var(--color-muted);
    max-width: 40ch;
  }

  .form-success,
  .form-error {
    font-family: var(--font-body);
    font-size: var(--text-base);
    padding: var(--space-4);
    border: var(--border-width) solid;
  }

  .form-success {
    color: var(--color-ink);
    border-color: var(--color-accent);
  }

  .form-error {
    color: var(--color-ink);
    border-color: var(--color-muted);
  }

  @media (max-width: 640px) {
    .body-selector {
      gap: var(--space-4);
    }

    .artist-pick-card {
      padding: var(--space-3) var(--space-1);
    }

    .step--submit {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-btn,
    .artist-pick-card,
    .body-map__area,
    .piercing-point,
    .form-input,
    .form-textarea,
    .submit-btn,
    .step:not([hidden]),
    .artist-picker:not([hidden]) {
      transition: none;
    }
  }
</style>

<script>
  // ── State ────────────────────────────────────────────────────────────
  const activeServices = new Set<string>()
  let selectedArtistTattoo = ''
  let selectedArtistPiercing = ''
  const selectedBodyAreas = new Set<string>()
  const selectedPiercingAreas = new Set<string>()

  // ── DOM refs ─────────────────────────────────────────────────────────
  const form            = document.getElementById('booking-form') as HTMLFormElement
  const stepArtists     = document.getElementById('step-artists')!
  const stepBody        = document.getElementById('step-body')!
  const stepPiercing    = document.getElementById('step-piercing')!
  const stepReference   = document.getElementById('step-reference')!
  const stepDescription = document.getElementById('step-description')!
  const stepSize        = document.getElementById('step-size')!
  const stepContact     = document.getElementById('step-contact')!
  const stepSubmit      = document.getElementById('step-submit')!
  const fSize           = document.getElementById('f-size') as HTMLInputElement
  const fService        = document.getElementById('f-service')    as HTMLInputElement
  const fArtistTattoo   = document.getElementById('f-artist-tattoo') as HTMLInputElement
  const fArtistPiercing = document.getElementById('f-artist-piercing') as HTMLInputElement
  const fBodyAreas      = document.getElementById('f-body-areas')  as HTMLInputElement
  const fPiercingAreas  = document.getElementById('f-piercing-areas') as HTMLInputElement
  const bodyAreaDisplay = document.getElementById('body-area-display')
  const piercingDisplay = document.getElementById('piercing-area-display')
  const formSuccess     = document.getElementById('form-success')!
  const formError       = document.getElementById('form-error')!
  const formValidation  = document.getElementById('form-validation')!

  // ── Helpers ──────────────────────────────────────────────────────────
  function show(el: HTMLElement) { el.hidden = false }
  function hide(el: HTMLElement) { el.hidden = true }

  function syncVisibility() {
    const hasTattoo   = activeServices.has('tattoo')
    const hasPiercing = activeServices.has('piercing')
    const hasAny      = hasTattoo || hasPiercing

    // Artist pickers — appear as soon as service is toggled
    if (hasAny) {
      show(stepArtists)
      const tattooPickerEl   = stepArtists.querySelector<HTMLElement>('[data-picker="tattoo"]')!
      const piercingPickerEl = stepArtists.querySelector<HTMLElement>('[data-picker="piercing"]')!
      hasTattoo   ? show(tattooPickerEl)   : hide(tattooPickerEl)
      hasPiercing ? show(piercingPickerEl) : hide(piercingPickerEl)
    } else {
      hide(stepArtists)
    }

    // Body/piercing selectors — only after respective artist is selected
    ;(hasTattoo && selectedArtistTattoo)   ? show(stepBody)     : hide(stepBody)
    ;(hasPiercing && selectedArtistPiercing) ? show(stepPiercing) : hide(stepPiercing)

    // Reference / description / submit — appear once any artist is picked
    const anyArtistPicked = (hasTattoo && selectedArtistTattoo) || (hasPiercing && selectedArtistPiercing)
    if (anyArtistPicked) {
      if (hasTattoo) show(stepSize); else hide(stepSize)
      show(stepReference)
      show(stepDescription)
      show(stepContact)
      show(stepSubmit)
    } else {
      hide(stepSize)
      hide(stepReference)
      hide(stepDescription)
      hide(stepContact)
      hide(stepSubmit)
    }

    // Dim cards that don't match active services
    document.querySelectorAll<HTMLElement>('.artist-pick-card').forEach(card => {
      const cardServices = (card.dataset.services ?? '').split(',')
      const matches = cardServices.some(s => activeServices.has(s))
      card.classList.toggle('dimmed', !matches)
    })
  }

  function syncHiddenInputs() {
    fService.value        = Array.from(activeServices).join('+')
    fArtistTattoo.value   = selectedArtistTattoo
    fArtistPiercing.value = selectedArtistPiercing
    fBodyAreas.value      = Array.from(selectedBodyAreas).join(', ')
    fPiercingAreas.value  = Array.from(selectedPiercingAreas).join(', ')
    // fSize updated directly by size-btn handler
  }

  // ── Service toggle handlers ───────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.service-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const svc = btn.dataset.service!
      if (activeServices.has(svc)) {
        activeServices.delete(svc)
        btn.setAttribute('aria-pressed', 'false')
        // Clear selection for this service
        if (svc === 'tattoo') {
          selectedArtistTattoo = ''
          document.querySelectorAll<HTMLElement>('[data-picker-target="tattoo"]').forEach(c => {
            c.setAttribute('aria-pressed', 'false')
          })
        } else {
          selectedArtistPiercing = ''
          document.querySelectorAll<HTMLElement>('[data-picker-target="piercing"]').forEach(c => {
            c.setAttribute('aria-pressed', 'false')
          })
        }
      } else {
        activeServices.add(svc)
        btn.setAttribute('aria-pressed', 'true')
      }
      syncVisibility()
      syncHiddenInputs()
    })
  })

  // ── Artist card selection ─────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('.artist-pick-card').forEach(card => {
    card.addEventListener('click', () => {
      if (card.classList.contains('dimmed')) return
      const pickerTarget = card.dataset.pickerTarget!
      const name = card.dataset.artistName!

      // Deselect siblings in same picker
      document.querySelectorAll<HTMLElement>(`[data-picker-target="${pickerTarget}"]`).forEach(c => {
        c.setAttribute('aria-pressed', 'false')
      })

      card.setAttribute('aria-pressed', 'true')

      if (pickerTarget === 'tattoo') {
        selectedArtistTattoo = name
      } else {
        selectedArtistPiercing = name
      }
      syncVisibility()
      syncHiddenInputs()
    })
  })

  // ── Body area multi-select ────────────────────────────────────────────
  document.querySelectorAll<SVGElement>('.body-map__area').forEach(area => {
    const toggle = () => {
      const areaId = area.getAttribute('data-area')!
      const label  = area.getAttribute('data-label')!
      if (selectedBodyAreas.has(areaId)) {
        selectedBodyAreas.delete(areaId)
        area.setAttribute('aria-checked', 'false')
      } else {
        selectedBodyAreas.add(areaId)
        area.setAttribute('aria-checked', 'true')
      }
      if (bodyAreaDisplay) {
        bodyAreaDisplay.textContent = selectedBodyAreas.size === 0
          ? (bodyAreaDisplay.dataset.placeholder ?? '')
          : Array.from(document.querySelectorAll<SVGElement>('.body-map__area[aria-checked="true"]'))
              .map(el => el.getAttribute('data-label') ?? '')
              .filter(Boolean)
              .join(', ')
      }
      syncHiddenInputs()
    }
    area.addEventListener('click', toggle)
    area.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle() }
    })
  })

  function updatePiercingDisplay () {
    if (piercingDisplay) {
      piercingDisplay.textContent = selectedPiercingAreas.size === 0
        ? (piercingDisplay.dataset.placeholder ?? '')
        : Array.from(selectedPiercingAreas).join(', ')
    }
  }

  // ── Body piercing point toggle (predefined zones on body silhouette) ──
  document.querySelectorAll<SVGCircleElement>('.piercing-point').forEach(point => {
    const toggle = () => {
      const label = point.dataset.label!
      if (selectedPiercingAreas.has(label)) {
        selectedPiercingAreas.delete(label)
        point.setAttribute('aria-checked', 'false')
      } else {
        selectedPiercingAreas.add(label)
        point.setAttribute('aria-checked', 'true')
      }
      updatePiercingDisplay()
      syncHiddenInputs()
    }
    point.addEventListener('click', toggle)
    point.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle() }
    })
  })

  // ── Piercing tab switching ────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.piercing-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const panelId = tab.getAttribute('aria-controls')!
      document.querySelectorAll('.piercing-tab').forEach(t => {
        t.setAttribute('aria-selected', 'false')
        t.classList.remove('piercing-tab--active')
      })
      document.querySelectorAll<HTMLElement>('.piercing-panel').forEach(p => { p.hidden = true })
      tab.setAttribute('aria-selected', 'true')
      tab.classList.add('piercing-tab--active')
      document.getElementById(panelId)!.hidden = false
    })
  })

  // ── Size selection ───────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.size-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const alreadySelected = btn.getAttribute('aria-pressed') === 'true'
      document.querySelectorAll('.size-btn').forEach(b => b.setAttribute('aria-pressed', 'false'))
      if (!alreadySelected) {
        btn.setAttribute('aria-pressed', 'true')
        fSize.value = btn.dataset.size ?? ''
      } else {
        fSize.value = ''
      }
    })
  })

  // ── Pre-select artist and service from URL params ────────────────────
  const params = new URLSearchParams(window.location.search)
  const artistParam  = params.get('artista')
  const servicoParam = params.get('servico') ?? 'tattoo'
  if (artistParam) {
    const services = servicoParam.split(',')
    services.forEach(svc => {
      const serviceBtn = document.querySelector<HTMLButtonElement>(`[data-service="${svc}"]`)
      if (serviceBtn && !activeServices.has(svc)) serviceBtn.click()
    })
    const firstService = services[0]
    const card = document.querySelector<HTMLElement>(`[data-artist-id="${artistParam}"][data-picker-target="${firstService}"]`)
    if (card) setTimeout(() => card.click(), 50)
  }

  // ── Form submit via Formspree AJAX ────────────────────────────────────
  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    syncHiddenInputs()
    hide(formValidation)
    hide(formError)

    // novalidate suppresses native checks — run them manually so empty
    // required fields can't submit silently
    if (!form.checkValidity()) {
      show(formValidation)
      form.reportValidity()
      return
    }

    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement
    submitBtn.disabled = true

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      })
      if (response.ok) {
        form.hidden = true
        show(formSuccess)
      } else {
        show(formError)
        submitBtn.disabled = false
      }
    } catch {
      show(formError)
      submitBtn.disabled = false
    }
  })
</script>
