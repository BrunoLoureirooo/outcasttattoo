    border: var(--border-width) solid var(--color-border);
    cursor: pointer;
    padding: 0;
    transition:
      flex 0.45s var(--ease-out-expo),
      border-color var(--duration-fast) ease;
  }

  .artist-pick-card[aria-pressed="true"] {
    flex: 5 1 0;
    border-color: var(--color-accent);
  }

  .artist-pick-card.dimmed {
    opacity: 0.25;
    pointer-events: none;
  }

  /* Initial — main visual in narrow state, ghost in expanded state */
  .artist-pick-card__avatar {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-4xl);
    line-height: 1;
    color: var(--color-muted);
    transition:
      font-size 0.45s var(--ease-out-expo),
      color 0.3s ease,
      transform 0.45s var(--ease-out-expo);
    z-index: 1;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .artist-pick-card[aria-pressed="true"] .artist-pick-card__avatar {
    position: absolute;
    inset: 0;
    font-size: clamp(8rem, 20vw, 14rem);
    color: oklch(0.96 0 0 / 0.05);
    z-index: 0;
  }

  /* Dice card SVG avatar */
  .artist-pick-card--dice .artist-pick-card__avatar svg {
    width: clamp(28px, 4vw, 40px);
    height: clamp(28px, 4vw, 40px);
    color: var(--color-muted);
    transition: width 0.45s var(--ease-out-expo), height 0.45s var(--ease-out-expo);
  }

  .artist-pick-card--dice[aria-pressed="true"] .artist-pick-card__avatar svg {
    width: clamp(60px, 12vw, 100px);
    height: clamp(60px, 12vw, 100px);
    color: oklch(0.96 0 0 / 0.05);
  }

  /* Details — hidden in narrow state, revealed when selected */
  .artist-pick-card__details {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-5) var(--space-5) var(--space-5);
    background: var(--color-surface);
    border-top: var(--border-width) solid var(--color-border);
    z-index: 2;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.25s ease 0.2s,
      transform 0.25s ease 0.2s;
    pointer-events: none;
  }

  .artist-pick-card[aria-pressed="true"] .artist-pick-card__details {
    opacity: 1;
    transform: none;
  }

  .artist-pick-card__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    color: var(--color-ink);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .artist-pick-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .artist-pick-card__tag {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-muted);
    border: var(--border-width) solid var(--color-border);
    padding: 1px var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  /* ── Body area selector ───────────────────────── */

  .body-selector {
    display: flex;
    gap: var(--space-8);
  }

  .body-map {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .body-map__svg {
    width: 100%;
    max-width: 130px;
  }

  .body-map__label {
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .body-map__area {
    fill: var(--color-surface);
    stroke: var(--color-border);
    stroke-width: 1;
    cursor: pointer;
    transition: fill var(--duration-fast) ease, stroke var(--duration-fast) ease;
  }

  .body-map__area:hover {
    fill: oklch(from var(--color-accent) l c h / 0.2);
    stroke: var(--color-accent-dim);
  }

  .body-map__area[aria-checked="true"] {
    fill: oklch(from var(--color-accent) l c h / 0.35);
    stroke: var(--color-accent);
  }

  .body-area-display {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-style: italic;
    margin-top: var(--space-2);
  }

  /* ── Piercing selector ────────────────────────── */

  .piercing-tabs {
    display: flex;
    gap: var(--space-2);
    border-bottom: var(--border-width) solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  .piercing-tab {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-muted);
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: var(--space-2) var(--space-4);
    margin-bottom: -1px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .piercing-tab--active,
  .piercing-tab[aria-selected="true"] {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .piercing-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .piercing-svg {
    width: 100%;
    max-width: 320px;
  }

  .ear-pair {
    display: flex;
    gap: var(--space-8);
    justify-content: center;
  }

  .ear-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .ear-svg {
    width: clamp(100px, 22vw, 160px);
    height: auto;
  }

  .ear-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .piercing-label-text {
    font-family: var(--font-body);
    font-size: 10px;
    fill: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .piercing-point {
    fill: var(--color-surface);
    stroke: var(--color-border);
    stroke-width: 1.5;
    cursor: pointer;
    transition: fill var(--duration-fast) ease, stroke var(--duration-fast) ease;
  }

  .piercing-point:hover {
    fill: oklch(from var(--color-accent) l c h / 0.3);
    stroke: var(--color-accent-dim);
  }

  .piercing-point[aria-checked="true"] {
    fill: var(--color-accent);
    stroke: var(--color-accent);
  }

  /* ── Form fields ──────────────────────────────── */

  .form-input,
  .form-textarea {
    width: 100%;
    max-width: 600px;
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: var(--text-base);
    padding: var(--space-3) var(--space-4);
    transition: border-color var(--duration-fast) ease;
    appearance: none;
  }

  .form-input:focus,
  .form-textarea:focus {
    border-color: var(--color-accent);
    outline: none;
  }

  .form-input::placeholder,
  .form-textarea::placeholder {
    color: var(--color-muted);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  /* ── Optional label ──────────────────────────── */

  .optional {
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-transform: none;
    letter-spacing: 0;
    opacity: 0.7;
  }

  /* ── Size selector ────────────────────────────── */

  .size-btns {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .size-btn {
    flex: 1 1 140px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
    background: transparent;
    border: var(--border-width) solid var(--color-border);
    cursor: pointer;
    text-align: left;
    transition: border-color var(--duration-fast) ease;
  }

  .size-btn[aria-pressed="true"] {
    border-color: var(--color-accent);
  }

  .size-btn:hover:not([aria-pressed="true"]) {
    border-color: var(--color-muted);
  }

  .size-btn__label {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: -0.01em;
    transition: color var(--duration-fast) ease;
  }

  .size-btn[aria-pressed="true"] .size-btn__label {
    color: var(--color-accent);
  }

  .size-btn__ref {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-muted);
    letter-spacing: 0.03em;
  }

  /* ── Contact fields ──────────────────────────── */

  .contact-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--space-4);
  }

  .contact-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  @media (max-width: 640px) {
    .contact-row {
      grid-template-columns: 1fr;
