---
import { strings } from '@/content/strings.pt.ts'
import artists from '@/data/artists.json'

const { marcar, common } = strings
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID ?? 'PLACEHOLDER'
const formspreeUrl = `https://formspree.io/f/${formspreeId}`
---

<section class="booking" aria-labelledby="booking-heading">
  <div class="container">
    <header class="booking__header">
      <h1 id="booking-heading" class="booking__heading">{marcar.heading}</h1>
      <p class="booking__intro">{marcar.intro}</p>
    </header>

    <form
      class="booking-form"
      id="booking-form"
      action={formspreeUrl}
      method="POST"
      novalidate
    >
      <!-- Honeypot -->
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
      <input type="hidden" name="_subject" value="Nova marcação — Outcast Tattoo" />

      <!-- Hidden state carriers (JS populates before submit) -->
      <input type="hidden" name="servico" id="f-service" />
      <input type="hidden" name="artista_tatuagem" id="f-artist-tattoo" />
      <input type="hidden" name="artista_piercing" id="f-artist-piercing" />
      <input type="hidden" name="zonas_tatuagem" id="f-body-areas" />
      <input type="hidden" name="zonas_piercing" id="f-piercing-areas" />
      <input type="hidden" name="tamanho" id="f-size" />

      <!-- ── Step 1: Service toggle ────────────────────────────── -->
      <fieldset class="step step--service" id="step-service">
        <legend class="step__label">{marcar.services.label}</legend>
        <div class="service-toggles">
          <button type="button" class="service-btn" data-service="tattoo" aria-pressed="false">
            {marcar.services.tattoo}
          </button>
          <button type="button" class="service-btn" data-service="piercing" aria-pressed="false">
            {marcar.services.piercing}
          </button>
        </div>
      </fieldset>

      <!-- ── Step 2: Artist selection ──────────────────────────── -->
      <div class="step step--artists" id="step-artists" hidden>

        <!-- Tattoo artist picker -->
        <div class="artist-picker" data-picker="tattoo" hidden>
          <p class="step__label">{marcar.artistTattoo.label}</p>
          <div class="artist-cards" role="group" aria-label={marcar.artistTattoo.label}>
            {artists.map(a => (
              <button
                type="button"
                class="artist-pick-card"
                data-artist-id={a.id}
                data-artist-name={a.name}
                data-services={a.services.join(',')}
                data-picker-target="tattoo"
                aria-pressed="false"
                aria-label={a.name}
              >
                <span class="artist-pick-card__avatar" aria-hidden="true">{a.name.charAt(0)}</span>
                <div class="artist-pick-card__details">
                  <span class="artist-pick-card__name">{a.name}</span>
                  <div class="artist-pick-card__tags">
                    {a.services.map(s => (
                      <span class="artist-pick-card__tag">{s === 'tattoo' ? marcar.services.tattoo : marcar.services.piercing}</span>
                    ))}
                  </div>
                </div>
              </button>
            ))}
            <button
              type="button"
              class="artist-pick-card artist-pick-card--dice"
              data-artist-id="no-preference"
              data-artist-name={marcar.noPreference}
              data-services="tattoo,piercing"
              data-picker-target="tattoo"
              aria-pressed="false"
              aria-label={marcar.noPreference}
            >
              <span class="artist-pick-card__avatar" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.2" fill="currentColor" stroke="none"/>
                  <circle cx="15.5" cy="8.5" r="1.2" fill="currentColor" stroke="none"/>
                  <circle cx="8.5" cy="15.5" r="1.2" fill="currentColor" stroke="none"/>
                  <circle cx="15.5" cy="15.5" r="1.2" fill="currentColor" stroke="none"/>
                  <circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"/>
                </svg>
              </span>
              <div class="artist-pick-card__details">
                <span class="artist-pick-card__name">{marcar.noPreference}</span>
              </div>
            </button>
          </div>
        </div>

        <!-- Piercing artist picker -->
        <div class="artist-picker" data-picker="piercing" hidden>
          <p class="step__label">{marcar.artistPiercing.label}</p>
          <div class="artist-cards" role="group" aria-label={marcar.artistPiercing.label}>
            {artists.map(a => (
              <button
                type="button"
                class="artist-pick-card"
                data-artist-id={a.id}
                data-artist-name={a.name}
                data-services={a.services.join(',')}
                data-picker-target="piercing"
                aria-pressed="false"
                aria-label={a.name}
              >
                <span class="artist-pick-card__avatar" aria-hidden="true">{a.name.charAt(0)}</span>
                <div class="artist-pick-card__details">
                  <span class="artist-pick-card__name">{a.name}</span>
                  <div class="artist-pick-card__tags">
                    {a.services.map(s => (
                      <span class="artist-pick-card__tag">{s === 'tattoo' ? marcar.services.tattoo : marcar.services.piercing}</span>
                    ))}
                  </div>
                </div>
              </button>
            ))}
            <button
              type="button"
              class="artist-pick-card artist-pick-card--dice"
              data-artist-id="no-preference"
              data-artist-name={marcar.noPreference}
              data-services="tattoo,piercing"
              data-picker-target="piercing"
              aria-pressed="false"
              aria-label={marcar.noPreference}
            >
              <span class="artist-pick-card__avatar" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.2" fill="currentColor" stroke="none"/>
                  <circle cx="15.5" cy="8.5" r="1.2" fill="currentColor" stroke="none"/>
                  <circle cx="8.5" cy="15.5" r="1.2" fill="currentColor" stroke="none"/>
                  <circle cx="15.5" cy="15.5" r="1.2" fill="currentColor" stroke="none"/>
                  <circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"/>
                </svg>
              </span>
              <div class="artist-pick-card__details">
                <span class="artist-pick-card__name">{marcar.noPreference}</span>
              </div>
            </button>
          </div>
        </div>

      </div>

      <!-- ── Step 3a: Body area selector (tattoo) ───────────────── -->
      <fieldset class="step step--body-area" id="step-body" hidden>
        <legend class="step__label">{marcar.bodyArea.label}</legend>
        <div class="body-selector">
          <!-- Front silhouette -->
          <div class="body-map">
            <svg viewBox="0 0 120 270" xmlns="http://www.w3.org/2000/svg" class="body-map__svg" role="group" aria-label={marcar.bodyArea.front}>
              <g class="body-silhouette" aria-hidden="true">
                <!-- Head — bigger -->
                <ellipse cx="60" cy="19" rx="15" ry="17"/>
                <!-- Neck — wider, slightly waisted via cubic curves -->
                <path d="M 53,36 C 51,40 51,45 53,48 L 67,48 C 69,45 69,40 67,36 Z"/>
                <!-- Arms — pill shape: semicircle cap top, rounded bottom -->
                <path d="M 19,54.5 A 6.5,6.5 0 0,1 32,54.5 L 32,130 Q 25.5,136 19,130 Z"/>
                <path d="M 88,54.5 A 6.5,6.5 0 0,1 101,54.5 L 101,130 Q 94.5,136 88,130 Z"/>
                <!-- Body + legs: swept shoulder curve, continuous path -->
                <path d="M 53,48 C 44,48 34,51 34,57 L 34,260 Q 43,266 52,260 L 52,152 Q 60,144 68,152 L 68,260 Q 77,266 86,260 L 86,57 C 86,51 76,48 67,48 Z"/>
              </g>
              <!-- Hitboxes — transparent, positioned over silhouette regions -->
              <ellipse data-area="head" data-label="Cabeça"
                cx="60" cy="19" rx="15" ry="17"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Cabeça"/>
              <rect data-area="neck" data-label="Pescoço"
                x="53" y="36" width="14" height="12"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Pescoço"/>
              <rect data-area="chest" data-label="Peito"
                x="34" y="48" width="52" height="52"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Peito"/>
              <rect data-area="abdomen" data-label="Abdómen"
                x="34" y="100" width="52" height="52"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Abdómen"/>
              <rect data-area="upper-arm-left" data-label="Braço esquerdo (superior)"
                x="19" y="48" width="13" height="45"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Braço esquerdo superior"/>
              <rect data-area="forearm-left" data-label="Antebraço esquerdo"
                x="19" y="93" width="13" height="37"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Antebraço esquerdo"/>
              <rect data-area="upper-arm-right" data-label="Braço direito (superior)"
                x="88" y="48" width="13" height="45"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Braço direito superior"/>
              <rect data-area="forearm-right" data-label="Antebraço direito"
                x="88" y="93" width="13" height="37"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Antebraço direito"/>
              <rect data-area="thigh-left" data-label="Coxa esquerda"
                x="34" y="152" width="18" height="56"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Coxa esquerda"/>
              <rect data-area="calf-left" data-label="Canela esquerda"
                x="34" y="208" width="18" height="52"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Canela esquerda"/>
              <rect data-area="thigh-right" data-label="Coxa direita"
                x="68" y="152" width="18" height="56"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Coxa direita"/>
              <rect data-area="calf-right" data-label="Canela direita"
                x="68" y="208" width="18" height="52"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Canela direita"/>
            </svg>
            <span class="body-map__label">{marcar.bodyArea.front}</span>
          </div>
          <!-- Back silhouette -->
          <div class="body-map">
            <svg viewBox="0 0 120 270" xmlns="http://www.w3.org/2000/svg" class="body-map__svg" role="group" aria-label={marcar.bodyArea.back}>
              <g class="body-silhouette" aria-hidden="true">
                <ellipse cx="60" cy="19" rx="15" ry="17"/>
                <path d="M 53,36 C 51,40 51,45 53,48 L 67,48 C 69,45 69,40 67,36 Z"/>
                <path d="M 19,54.5 A 6.5,6.5 0 0,1 32,54.5 L 32,130 Q 25.5,136 19,130 Z"/>
                <path d="M 88,54.5 A 6.5,6.5 0 0,1 101,54.5 L 101,130 Q 94.5,136 88,130 Z"/>
                <path d="M 53,48 C 44,48 34,51 34,57 L 34,260 Q 43,266 52,260 L 52,152 Q 60,144 68,152 L 68,260 Q 77,266 86,260 L 86,57 C 86,51 76,48 67,48 Z"/>
              </g>
              <ellipse data-area="head-back" data-label="Cabeça (costas)"
                cx="60" cy="19" rx="15" ry="17"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Cabeça (costas)"/>
              <rect data-area="upper-back" data-label="Costas superiores"
                x="34" y="48" width="52" height="52"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Costas superiores"/>
              <rect data-area="lower-back" data-label="Costas inferiores"
                x="34" y="100" width="52" height="52"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Costas inferiores"/>
              <rect data-area="upper-arm-left-back" data-label="Braço esquerdo superior (costas)"
                x="19" y="48" width="13" height="45"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Braço esquerdo superior (costas)"/>
              <rect data-area="forearm-left-back" data-label="Antebraço esquerdo (costas)"
                x="19" y="93" width="13" height="37"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Antebraço esquerdo (costas)"/>
              <rect data-area="upper-arm-right-back" data-label="Braço direito superior (costas)"
                x="88" y="48" width="13" height="45"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Braço direito superior (costas)"/>
              <rect data-area="forearm-right-back" data-label="Antebraço direito (costas)"
                x="88" y="93" width="13" height="37"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Antebraço direito (costas)"/>
              <rect data-area="ham-left" data-label="Isquiotibial esquerdo"
                x="34" y="152" width="18" height="56"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Isquiotibial esquerdo"/>
              <rect data-area="gemeo-left" data-label="Gémeo esquerdo"
                x="34" y="208" width="18" height="52"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Gémeo esquerdo"/>
              <rect data-area="ham-right" data-label="Isquiotibial direito"
                x="68" y="152" width="18" height="56"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Isquiotibial direito"/>
              <rect data-area="gemeo-right" data-label="Gémeo direito"
                x="68" y="208" width="18" height="52"
                class="body-map__area" tabindex="0" role="checkbox" aria-checked="false" aria-label="Gémeo direito"/>
            </svg>
            <span class="body-map__label">{marcar.bodyArea.back}</span>
          </div>
        </div>
        <p class="body-area-display" id="body-area-display" aria-live="polite" data-placeholder={marcar.bodyArea.placeholder}>
          {marcar.bodyArea.placeholder}
        </p>
      </fieldset>

      <!-- ── Step 3b: Piercing selector ────────────────────────── -->
      <fieldset class="step step--piercing" id="step-piercing" hidden>
        <legend class="step__label">{marcar.piercingArea.label}</legend>

        <!-- Tab navigation -->
        <div class="piercing-tabs" role="tablist">
          <button type="button" class="piercing-tab piercing-tab--active"
            role="tab" aria-selected="true" aria-controls="piercing-panel-ear" id="tab-ear">
            {marcar.piercingArea.ear}
          </button>
          <button type="button" class="piercing-tab"
            role="tab" aria-selected="false" aria-controls="piercing-panel-body" id="tab-body">
            {marcar.piercingArea.body}
          </button>
        </div>

        <!-- Ear panel -->
        <div class="piercing-panel" id="piercing-panel-ear" role="tabpanel" aria-labelledby="tab-ear">
          <p class="ear-hint">{marcar.piercingArea.placeholder}</p>
          <div class="ear-pair">

            <!-- LEFT EAR — ear.svg inlined, viewBox 0 0 736 1422 -->
            <div class="ear-wrap">
              <svg viewBox="0 0 736 1422" xmlns="http://www.w3.org/2000/svg"
                   class="ear-svg" data-ear="esquerda"
                   role="group" aria-label={marcar.piercingArea.earLeft}>
