  /* ── Submit ───────────────────────────────────── */

  .step--submit {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .submit-btn {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-accent);
    background: transparent;
    border: var(--border-width) solid var(--color-accent);
    padding: var(--space-3) var(--space-8);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out-expo),
      color var(--duration-fast) var(--ease-out-expo);
  }

  .submit-btn:hover {
    background-color: var(--color-accent);
    color: var(--color-bg);
  }

  .submit-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .form-disclaimer {
    font-size: var(--text-xs);
    color: var(--color-muted);
    max-width: 40ch;
  }

  .form-success,
  .form-error {
    font-family: var(--font-body);
    font-size: var(--text-base);
    padding: var(--space-4);
    border: var(--border-width) solid;
  }

  .form-success {
    color: var(--color-ink);
    border-color: var(--color-accent);
  }

  .form-error {
    color: var(--color-ink);
    border-color: var(--color-muted);
  }

  @media (max-width: 640px) {
    .body-selector {
      gap: var(--space-4);
    }

    .artist-pick-card {
      padding: var(--space-3) var(--space-1);
    }

    .step--submit {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-btn,
    .artist-pick-card,
    .body-map__area,
    .piercing-point,
    .form-input,
    .form-textarea,
    .submit-btn {
      transition: none;
    }
  }
</style>

<script>
  // ── State ────────────────────────────────────────────────────────────
  const activeServices = new Set<string>()
  let selectedArtistTattoo = ''
  let selectedArtistPiercing = ''
  const selectedBodyAreas = new Set<string>()
  const selectedPiercingAreas = new Set<string>()

  // ── DOM refs ─────────────────────────────────────────────────────────
  const form            = document.getElementById('booking-form') as HTMLFormElement
  const stepArtists     = document.getElementById('step-artists')!
  const stepBody        = document.getElementById('step-body')!
  const stepPiercing    = document.getElementById('step-piercing')!
  const stepReference   = document.getElementById('step-reference')!
  const stepDescription = document.getElementById('step-description')!
  const stepSize        = document.getElementById('step-size')!
  const stepContact     = document.getElementById('step-contact')!
  const stepSubmit      = document.getElementById('step-submit')!
  const fSize           = document.getElementById('f-size') as HTMLInputElement
  const fService        = document.getElementById('f-service')    as HTMLInputElement
  const fArtistTattoo   = document.getElementById('f-artist-tattoo') as HTMLInputElement
  const fArtistPiercing = document.getElementById('f-artist-piercing') as HTMLInputElement
  const fBodyAreas      = document.getElementById('f-body-areas')  as HTMLInputElement
  const fPiercingAreas  = document.getElementById('f-piercing-areas') as HTMLInputElement
  const bodyAreaDisplay = document.getElementById('body-area-display')
  const piercingDisplay = document.getElementById('piercing-area-display')
  const formSuccess     = document.getElementById('form-success')!
  const formError       = document.getElementById('form-error')!

  // ── Helpers ──────────────────────────────────────────────────────────
  function show(el: HTMLElement) { el.hidden = false }
  function hide(el: HTMLElement) { el.hidden = true }

  function syncVisibility() {
    const hasTattoo   = activeServices.has('tattoo')
    const hasPiercing = activeServices.has('piercing')
    const hasAny      = hasTattoo || hasPiercing

    // Artist pickers — appear as soon as service is toggled
    if (hasAny) {
      show(stepArtists)
      const tattooPickerEl   = stepArtists.querySelector<HTMLElement>('[data-picker="tattoo"]')!
      const piercingPickerEl = stepArtists.querySelector<HTMLElement>('[data-picker="piercing"]')!
      hasTattoo   ? show(tattooPickerEl)   : hide(tattooPickerEl)
      hasPiercing ? show(piercingPickerEl) : hide(piercingPickerEl)
    } else {
      hide(stepArtists)
    }

    // Body/piercing selectors — only after respective artist is selected
    ;(hasTattoo && selectedArtistTattoo)   ? show(stepBody)     : hide(stepBody)
    ;(hasPiercing && selectedArtistPiercing) ? show(stepPiercing) : hide(stepPiercing)

    // Reference / description / submit — appear once any artist is picked
    const anyArtistPicked = (hasTattoo && selectedArtistTattoo) || (hasPiercing && selectedArtistPiercing)
    if (anyArtistPicked) {
      if (hasTattoo) show(stepSize); else hide(stepSize)
      show(stepReference)
      show(stepDescription)
      show(stepContact)
      show(stepSubmit)
    } else {
      hide(stepSize)
      hide(stepReference)
      hide(stepDescription)
      hide(stepContact)
      hide(stepSubmit)
    }

    // Dim cards that don't match active services
    document.querySelectorAll<HTMLElement>('.artist-pick-card').forEach(card => {
      const cardServices = (card.dataset.services ?? '').split(',')
      const matches = cardServices.some(s => activeServices.has(s))
      card.classList.toggle('dimmed', !matches)
    })
  }

  function syncHiddenInputs() {
    fService.value        = Array.from(activeServices).join('+')
    fArtistTattoo.value   = selectedArtistTattoo
    fArtistPiercing.value = selectedArtistPiercing
    fBodyAreas.value      = Array.from(selectedBodyAreas).join(', ')
    fPiercingAreas.value  = Array.from(selectedPiercingAreas).join(', ')
    // fSize updated directly by size-btn handler
  }

  // ── Service toggle handlers ───────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.service-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const svc = btn.dataset.service!
      if (activeServices.has(svc)) {
        activeServices.delete(svc)
        btn.setAttribute('aria-pressed', 'false')
        // Clear selection for this service
        if (svc === 'tattoo') {
          selectedArtistTattoo = ''
          document.querySelectorAll<HTMLElement>('[data-picker-target="tattoo"]').forEach(c => {
            c.setAttribute('aria-pressed', 'false')
          })
        } else {
          selectedArtistPiercing = ''
          document.querySelectorAll<HTMLElement>('[data-picker-target="piercing"]').forEach(c => {
            c.setAttribute('aria-pressed', 'false')
          })
        }
      } else {
        activeServices.add(svc)
        btn.setAttribute('aria-pressed', 'true')
      }
      syncVisibility()
      syncHiddenInputs()
    })
  })

  // ── Artist card selection ─────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('.artist-pick-card').forEach(card => {
    card.addEventListener('click', () => {
      if (card.classList.contains('dimmed')) return
      const pickerTarget = card.dataset.pickerTarget!
      const name = card.dataset.artistName!

      // Deselect siblings in same picker
      document.querySelectorAll<HTMLElement>(`[data-picker-target="${pickerTarget}"]`).forEach(c => {
        c.setAttribute('aria-pressed', 'false')
      })

      card.setAttribute('aria-pressed', 'true')

      if (pickerTarget === 'tattoo') {
        selectedArtistTattoo = name
      } else {
        selectedArtistPiercing = name
      }
      syncVisibility()
      syncHiddenInputs()
    })
  })

  // ── Body area multi-select ────────────────────────────────────────────
  document.querySelectorAll<SVGElement>('.body-map__area').forEach(area => {
    const toggle = () => {
      const areaId = area.getAttribute('data-area')!
      const label  = area.getAttribute('data-label')!
      if (selectedBodyAreas.has(areaId)) {
        selectedBodyAreas.delete(areaId)
        area.setAttribute('aria-checked', 'false')
      } else {
        selectedBodyAreas.add(areaId)
        area.setAttribute('aria-checked', 'true')
      }
      if (bodyAreaDisplay) {
        bodyAreaDisplay.textContent = selectedBodyAreas.size === 0
          ? 'Seleciona uma ou mais áreas no diagrama'
          : Array.from(document.querySelectorAll<SVGElement>('.body-map__area[aria-checked="true"]'))
              .map(el => el.getAttribute('data-label') ?? '')
              .filter(Boolean)
              .join(', ')
      }
      syncHiddenInputs()
    }
    area.addEventListener('click', toggle)
    area.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle() }
    })
  })

  // ── Piercing point multi-select ───────────────────────────────────────
  document.querySelectorAll<SVGCircleElement>('.piercing-point').forEach(point => {
    const toggle = () => {
      const id    = point.dataset.piercing!
      const label = point.dataset.label!
      if (selectedPiercingAreas.has(label)) {
        selectedPiercingAreas.delete(label)
        point.setAttribute('aria-checked', 'false')
      } else {
        selectedPiercingAreas.add(label)
        point.setAttribute('aria-checked', 'true')
      }
      if (piercingDisplay) {
        piercingDisplay.textContent = selectedPiercingAreas.size === 0
          ? 'Seleciona a zona do piercing'
          : Array.from(selectedPiercingAreas).join(', ')
      }
      syncHiddenInputs()
    }
    point.addEventListener('click', toggle)
    point.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle() }
    })
  })

  // ── Piercing tab switching ────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.piercing-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const panelId = tab.getAttribute('aria-controls')!
      document.querySelectorAll('.piercing-tab').forEach(t => {
        t.setAttribute('aria-selected', 'false')
        t.classList.remove('piercing-tab--active')
      })
      document.querySelectorAll<HTMLElement>('.piercing-panel').forEach(p => { p.hidden = true })
      tab.setAttribute('aria-selected', 'true')
      tab.classList.add('piercing-tab--active')
      document.getElementById(panelId)!.hidden = false
    })
  })

  // ── Size selection ───────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.size-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const alreadySelected = btn.getAttribute('aria-pressed') === 'true'
      document.querySelectorAll('.size-btn').forEach(b => b.setAttribute('aria-pressed', 'false'))
      if (!alreadySelected) {
        btn.setAttribute('aria-pressed', 'true')
        fSize.value = btn.dataset.size ?? ''
      } else {
        fSize.value = ''
      }
    })
  })

  // ── Pre-select artist from URL param ─────────────────────────────────
  const params = new URLSearchParams(window.location.search)
  const artistParam = params.get('artista')
  if (artistParam) {
    // Activate tattoo service by default when coming from artist card
    const tattooBtn = document.querySelector<HTMLButtonElement>('[data-service="tattoo"]')
    if (tattooBtn && !activeServices.has('tattoo')) {
      tattooBtn.click()
    }
    // Select the matching artist card in the tattoo picker
    const card = document.querySelector<HTMLElement>(`[data-artist-id="${artistParam}"][data-picker-target="tattoo"]`)
    if (card) setTimeout(() => card.click(), 50)
  }

  // ── Form submit via Formspree AJAX ────────────────────────────────────
  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    syncHiddenInputs()

    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement
    submitBtn.disabled = true

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      })
      if (response.ok) {
        form.hidden = true
        show(formSuccess)
      } else {
        show(formError)
        submitBtn.disabled = false
      }
    } catch {
      show(formError)
      submitBtn.disabled = false
    }
  })
</script>
