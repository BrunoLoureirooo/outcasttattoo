---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { strings } from '@/content/strings.pt.ts'

interface Props {
  id:          string
  name:        string
  bio:         string
  specialties: string[]
  services:    string[]
  portrait?:   string
  portfolio:   string[]
}

const { id, name, bio, specialties, services, portrait, portfolio } = Astro.props
const { sobre, lightbox, artistCard, artistDetail, marcar } = strings

function serviceLabel(s: string) {
  return s === 'tattoo' ? marcar.services.tattoo : marcar.services.piercing
}

const images = import.meta.glob('/src/assets/artists/*.{webp,jpg,jpeg,png,avif}', {
  eager: true,
}) as Record<string, { default: ImageMetadata }>

function resolveImage(path?: string): ImageMetadata | undefined {
  if (!path) return undefined
  const basename = path.split('/').pop()
  return images[`/src/assets/artists/${basename}`]?.default
}

const portraitImg    = resolveImage(portrait)
const portfolioImgs  = portfolio.map(resolveImage).filter((m): m is ImageMetadata => Boolean(m))
const lightboxLabel  = lightbox.ariaLabel.replace('{name}', name)
const detailLabel    = artistDetail.ariaLabel.replace('{name}', name)
const portraitAlt    = sobre.portraitAlt.replace('{name}', name)
const portfolioAlt   = sobre.portfolioAlt.replace('{name}', name)
---

<article class="artist-card reveal" data-pending data-artist-id={id}>
  <div class="artist-card__image-wrap">
    {portraitImg ? (
      <Image
        src={portraitImg}
        alt={portraitAlt}
        class="artist-card__portrait"
        widths={[320, 480, 640, 960]}
        sizes="(max-width: 640px) 100vw, 380px"
      />
    ) : (
      <svg
        class="artist-card__fallback"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="0.75"
        aria-hidden="true"
        focusable="false"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle cx="12" cy="8.4" r="3.6" />
        <path d="M 4.5,21.5 c 0,-4.6 3.4,-7.2 7.5,-7.2 s 7.5,2.6 7.5,7.2" />
      </svg>
    )}
    <button
      type="button"
      class="artist-card__detail-trigger"
      data-detail-open
      aria-label={`${artistCard.viewMore} — ${name}`}
    >
      <span aria-hidden="true">{artistCard.viewMore}</span>
    </button>
  </div>

  <div class="artist-card__body">
    <h3 class="artist-card__name">{name}</h3>

    <ul class="artist-card__specialties" aria-label={sobre.specialties}>
      {specialties.map(s => (
        <li class="artist-card__tag">{s}</li>
      ))}
    </ul>

    <p class="artist-card__bio">{bio}</p>

    {portfolioImgs.length > 0 && (
      <div class="artist-card__portfolio" role="group" aria-label={lightboxLabel}>
        {portfolioImgs.map((img, i) => (
          <button
            type="button"
            class="artist-card__thumb"
            data-lightbox-open={i}
            aria-label={`${portfolioAlt} ${i + 1}`}
          >
            <Image src={img} alt="" width={320} class="artist-card__thumb-img" />
          </button>
        ))}
      </div>
    )}

    <div class="artist-card__actions">
      <div class="artist-card__services" data-services-toggle>
        {services.map(s => (
          <button type="button" class="artist-card__service-btn" data-service={s} aria-pressed="false">
            {serviceLabel(s)}
          </button>
        ))}
      </div>
      <button type="button" class="artist-card__book" data-book-btn disabled>
        {sobre.bookCta.replace('{name}', name)}
      </button>
    </div>
  </div>

  {portfolioImgs.length > 0 && (
    <dialog class="artist-card__lightbox" aria-label={lightboxLabel}>
      <div class="artist-card__lightbox-frame">
        {portfolioImgs.map((img, i) => (
          <figure class="artist-card__slide" hidden={i !== 0}>
            <Image
              src={img}
              alt={`${portfolioAlt} ${i + 1}`}
              widths={[640, 960, 1280]}
              sizes="90vw"
              class="artist-card__slide-img"
            />
          </figure>
        ))}
      </div>
      <div class="artist-card__lightbox-controls">
        {portfolioImgs.length > 1 && (
          <button type="button" class="artist-card__lightbox-btn" data-prev>
            ← {lightbox.previous}
          </button>
        )}
        <button type="button" class="artist-card__lightbox-btn" data-close>
          {lightbox.close}
        </button>
        {portfolioImgs.length > 1 && (
          <button type="button" class="artist-card__lightbox-btn" data-next>
            {lightbox.next} →
          </button>
        )}
      </div>
    </dialog>
  )}

  <dialog class="artist-card__detail" aria-label={detailLabel}>
    <div class="artist-card__detail-inner">
      <div class="artist-card__detail-header">
        <div class="artist-card__detail-portrait">
          {portraitImg ? (
            <Image
              src={portraitImg}
              alt={portraitAlt}
              class="artist-card__detail-portrait-img"
              widths={[480, 720, 960]}
              sizes="(max-width: 600px) 100vw, 40vw"
            />
          ) : (
            <svg
              class="artist-card__fallback artist-card__detail-portrait-fallback"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="0.75"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle cx="12" cy="8.4" r="3.6" />
              <path d="M 4.5,21.5 c 0,-4.6 3.4,-7.2 7.5,-7.2 s 7.5,2.6 7.5,7.2" />
            </svg>
          )}
        </div>

        <div class="artist-card__detail-info">
          <button type="button" class="artist-card__detail-close" data-detail-close>
            {artistDetail.close} ×
          </button>
          <h3 class="artist-card__detail-name">{name}</h3>
          <ul class="artist-card__specialties" aria-label={sobre.specialties}>
            {specialties.map(s => (
              <li class="artist-card__tag">{s}</li>
            ))}
          </ul>
          <p class="artist-card__detail-bio">{bio}</p>
          <div class="artist-card__detail-actions">
            <div class="artist-card__services" data-services-toggle>
              {services.map(s => (
                <button type="button" class="artist-card__service-btn" data-service={s} aria-pressed="false">
                  {serviceLabel(s)}
                </button>
              ))}
            </div>
            <button type="button" class="artist-card__book" data-book-btn disabled>
              {sobre.bookCta.replace('{name}', name)}
            </button>
          </div>
        </div>
      </div>

      {(portfolioImgs.length > 0 || portfolio.length > 0) && (
        <div class="artist-card__detail-gallery">
          <p class="artist-card__detail-gallery-label">{artistDetail.portfolio}</p>
          <div class="artist-card__detail-grid" role="group" aria-label={lightboxLabel}>
            {portfolioImgs.length > 0 ? (
              portfolioImgs.map((img, i) => (
                <button
                  type="button"
                  class="artist-card__detail-thumb"
                  data-lightbox-open={i}
                  aria-label={`${portfolioAlt} ${i + 1}`}
                >
                  <Image
                    src={img}
                    alt=""
                    widths={[480, 720]}
                    sizes="(max-width: 600px) 30vw, 28vw"
                    class="artist-card__detail-thumb-img"
                  />
                </button>
              ))
            ) : (
              portfolio.map(() => (
                <div class="artist-card__detail-thumb artist-card__detail-thumb--empty" aria-hidden="true" />
              ))
            )}
          </div>
        </div>
      )}
    </div>
  </dialog>
</article>

<style>
  .artist-card {
    display: grid;
    grid-template-rows: auto 1fr;
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    transition: border-color var(--duration-fast) ease;
  }

  .artist-card:hover {
    border-color: var(--color-accent-dim);
  }

  /* ── Image wrap: portrait + hover trigger ── */

  .artist-card__image-wrap {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .artist-card__portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(35%) contrast(1.05);
    transition:
      transform 0.4s var(--ease-out-expo),
      filter 0.35s ease;
  }

  .artist-card__image-wrap:hover .artist-card__portrait {
    transform: scale(1.03);
    filter: grayscale(50%) contrast(1.05) blur(4px);
  }

  .artist-card__fallback {
    width: 38%;
    color: var(--color-border);
  }

  /* Overlay button — covers the portrait, reveals label on hover */

  .artist-card__detail-trigger {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: transparent;
    border: none;
    margin: 0;
    padding: 0;
    cursor: pointer;
    color: transparent;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .artist-card__detail-trigger:hover,
  .artist-card__detail-trigger:focus-visible {
    background: oklch(0.05 0 0 / 0.58);
    color: var(--color-ink);
  }

  .artist-card__detail-trigger:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -3px;
  }

  /* ── Card body ── */

  .artist-card__body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .artist-card__name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-ink);
    letter-spacing: -0.02em;
  }

  .artist-card__specialties {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  .artist-card__tag {
    font-size: var(--text-xs);
    font-family: var(--font-body);
    color: var(--color-muted);
    border: var(--border-width) solid var(--color-border);
    padding: var(--space-1) var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .artist-card__bio {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 55ch;
  }

  /* ── Portfolio thumbnails ── */

  .artist-card__portfolio {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
  }

  .artist-card__thumb {
    padding: 0;
    border: var(--border-width) solid var(--color-border);
    background: var(--color-bg);
    cursor: pointer;
    aspect-ratio: 1;
    overflow: hidden;
    transition: border-color var(--duration-fast) ease;
  }

  .artist-card__thumb:hover,
  .artist-card__thumb:focus-visible {
    border-color: var(--color-accent);
  }

  .artist-card__thumb:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .artist-card__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(35%);
    transition: transform 0.4s var(--ease-out-expo);
  }

  .artist-card__thumb:hover .artist-card__thumb-img {
    transform: scale(1.05);
  }

  /* ── Actions ── */

  .artist-card__actions {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .artist-card__book {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-accent-dim);
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: text-decoration-color var(--duration-fast) ease, opacity var(--duration-fast) ease;
    white-space: nowrap;
  }

  .artist-card__book:hover:not(:disabled) {
    text-decoration-color: var(--color-accent);
  }

  .artist-card__book:disabled {
    opacity: 0.25;
    cursor: not-allowed;
  }

  .artist-card__book {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: text-decoration-color var(--duration-fast) ease;
  }

  .artist-card__services {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .artist-card__service-btn {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-muted);
    background: transparent;
    border: var(--border-width) solid var(--color-border);
    padding: var(--space-1) var(--space-4);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      opacity var(--duration-fast) ease;
  }

  .artist-card__service-btn[aria-pressed="true"] {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Dim unselected siblings when at least one is selected */
  .artist-card__services:has([aria-pressed="true"]) .artist-card__service-btn[aria-pressed="false"] {
    opacity: 0.35;
  }

  .artist-card__service-btn:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    opacity: 1;
  }

  .artist-card__service-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ── Lightbox — native <dialog> ── */

  .artist-card__lightbox {
    background: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-4);
    max-width: min(90vw, 920px);
    max-height: 90svh;
  }

  .artist-card__lightbox::backdrop {
    background: oklch(0.05 0 0 / 0.88);
  }

  .artist-card__slide {
    margin: 0;
  }

  .artist-card__slide-img {
    display: block;
    max-width: 100%;
    max-height: 72svh;
    width: auto;
    height: auto;
    margin-inline: auto;
  }

  .artist-card__lightbox-controls {
    display: flex;
    justify-content: center;
    gap: var(--space-6);
    padding-top: var(--space-4);
  }

  .artist-card__lightbox-btn {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: var(--space-2) var(--space-3);
    transition: color var(--duration-fast) ease;
  }

  .artist-card__lightbox-btn:hover,
  .artist-card__lightbox-btn:focus-visible {
    color: var(--color-accent);
  }

  .artist-card__lightbox-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ── Artist detail popup ── */

  .artist-card__detail {
    position: fixed;
    inset: 0;
    margin: auto;
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    padding: 0;
    width: min(92vw, 960px);
    max-height: 88svh;
    overflow-y: auto;
  }

  .artist-card__detail::backdrop {
    background: oklch(0.05 0 0 / 0.88);
  }

  .artist-card__detail-inner {
    display: flex;
    flex-direction: column;
  }

  .artist-card__detail-header {
    display: grid;
    grid-template-columns: 2fr 3fr;
  }

  .artist-card__detail-portrait {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .artist-card__detail-portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(30%) contrast(1.05);
  }

  .artist-card__detail-portrait-fallback {
    width: 32%;
  }

  .artist-card__detail-info {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: relative;
    min-height: 320px;
  }

  .artist-card__detail-close {
    align-self: flex-end;
    background: transparent;
    border: var(--border-width) solid var(--color-border);
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }

  .artist-card__detail-close:hover,
  .artist-card__detail-close:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .artist-card__detail-close:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .artist-card__detail-name {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-ink);
    letter-spacing: -0.02em;
    margin-top: var(--space-2);
  }

  .artist-card__detail-bio {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.8;
    max-width: 42ch;
  }

  .artist-card__detail-actions {
    margin-top: auto;
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
    align-items: baseline;
  }

  /* Portfolio gallery inside the detail modal */

  .artist-card__detail-gallery {
    padding: var(--space-8);
    border-top: var(--border-width) solid var(--color-border);
  }

  .artist-card__detail-gallery-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin-bottom: var(--space-6);
  }

  .artist-card__detail-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .artist-card__detail-thumb {
    padding: 0;
    border: var(--border-width) solid var(--color-border);
    background: var(--color-bg);
    cursor: pointer;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    transition: border-color var(--duration-fast) ease;
  }

  .artist-card__detail-thumb:hover,
  .artist-card__detail-thumb:focus-visible {
    border-color: var(--color-accent);
  }

  .artist-card__detail-thumb:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .artist-card__detail-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(20%);
    transition:
      transform 0.4s var(--ease-out-expo),
      filter var(--duration-fast) ease;
  }

  .artist-card__detail-thumb:hover .artist-card__detail-thumb-img {
    transform: scale(1.05);
    filter: grayscale(0%);
  }

  .artist-card__detail-thumb--empty {
    border-style: dashed;
    cursor: default;
    background: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 4px,
      oklch(1 0 0 / 0.02) 4px,
      oklch(1 0 0 / 0.02) 8px
    );
  }

  /* Responsive — stack portrait above info on small screens */

  @media (max-width: 600px) {
    .artist-card__detail-header {
      grid-template-columns: 1fr;
    }

    .artist-card__detail-portrait {
      aspect-ratio: 4 / 3;
    }

    .artist-card__detail-info {
      padding: var(--space-6);
      min-height: auto;
    }

    .artist-card__detail-gallery {
      padding: var(--space-6);
    }

    .artist-card__detail-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .artist-card,
    .artist-card__portrait,
    .artist-card__thumb,
    .artist-card__thumb-img,
    .artist-card__service-btn,
    .artist-card__lightbox-btn,
    .artist-card__detail-trigger,
    .artist-card__detail-close,
    .artist-card__detail-thumb,
    .artist-card__detail-thumb-img {
      transition: none;
    }

    .artist-card__image-wrap:hover .artist-card__portrait {
      transform: none;
      filter: grayscale(35%) contrast(1.05);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.artist-card').forEach(card => {
    // ── Lightbox ──
    const lightboxDialog = card.querySelector<HTMLDialogElement>('.artist-card__lightbox')
    if (lightboxDialog) {
      const slides = Array.from(lightboxDialog.querySelectorAll<HTMLElement>('.artist-card__slide'))
      let index = 0

      function setIndex(i: number) {
        index = (i + slides.length) % slides.length
        slides.forEach((slide, j) => { slide.hidden = j !== index })
      }

      card.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]').forEach(btn => {
        btn.addEventListener('click', () => {
          setIndex(Number(btn.dataset.lightboxOpen ?? 0))
          lightboxDialog.showModal()
        })
      })

      lightboxDialog.querySelector('[data-prev]')?.addEventListener('click', () => setIndex(index - 1))
      lightboxDialog.querySelector('[data-next]')?.addEventListener('click', () => setIndex(index + 1))
      lightboxDialog.querySelector('[data-close]')?.addEventListener('click', () => lightboxDialog.close())

      lightboxDialog.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft')  setIndex(index - 1)
        if (e.key === 'ArrowRight') setIndex(index + 1)
      })

      lightboxDialog.addEventListener('click', (e) => {
        if (e.target === lightboxDialog) lightboxDialog.close()
      })
    }

    // ── Service toggles + Marcar CTA ──
    const artistId = (card as HTMLElement).dataset.artistId ?? ''
    card.querySelectorAll<HTMLElement>('[data-services-toggle]').forEach(wrap => {
      const serviceBtns = Array.from(wrap.querySelectorAll<HTMLButtonElement>('[data-service]'))
      const bookBtn = wrap.parentElement?.querySelector<HTMLButtonElement>('[data-book-btn]')
      if (!bookBtn) return

      if (serviceBtns.length === 1) {
        serviceBtns[0].setAttribute('aria-pressed', 'true')
        bookBtn.disabled = false
        bookBtn.dataset.bookHref = `/marcar?artista=${artistId}&servico=${serviceBtns[0].dataset.service}`
      }

      serviceBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          btn.setAttribute('aria-pressed', btn.getAttribute('aria-pressed') === 'true' ? 'false' : 'true')
          const selected = serviceBtns.filter(b => b.getAttribute('aria-pressed') === 'true')
          bookBtn.disabled = selected.length === 0
          if (selected.length > 0) {
            bookBtn.dataset.bookHref = `/marcar?artista=${artistId}&servico=${selected.map(b => b.dataset.service).join(',')}`
          }
        })
      })

      bookBtn.addEventListener('click', () => {
        if (bookBtn.dataset.bookHref) window.location.href = bookBtn.dataset.bookHref
      })
    })

    // ── Artist detail popup ──
    const detailDialog = card.querySelector<HTMLDialogElement>('.artist-card__detail')
    if (detailDialog) {
      card.querySelector('[data-detail-open]')?.addEventListener('click', () => detailDialog.showModal())
      detailDialog.querySelector('[data-detail-close]')?.addEventListener('click', () => detailDialog.close())
      detailDialog.addEventListener('click', (e) => {
        if (e.target === detailDialog) detailDialog.close()
      })
    }
  })
</script>
