---
import { strings } from '@/content/strings.pt.ts'

interface Props {
  id:          string
  name:        string
  bio:         string
  specialties: string[]
  services:    string[]
  booksy_url:  string
  portrait?:   string
  portfolio:   string[]
}

const { id, name, bio, specialties } = Astro.props
const { artistCard, sobre } = strings
const initial = name.charAt(0)
---

<article class="artist-card reveal" data-pending>
  <div class="artist-card__image-wrap" aria-hidden="true">
    <span class="artist-card__initial">{initial}</span>
  </div>

  <div class="artist-card__body">
    <h3 class="artist-card__name">{name}</h3>

    <ul class="artist-card__specialties" aria-label={sobre.specialties}>
      {specialties.map(s => (
        <li class="artist-card__tag">{s}</li>
      ))}
    </ul>

    <p class="artist-card__bio">{bio}</p>

    <a href={`/marcar?artista=${id}`} class="artist-card__book">
      {sobre.bookCta.replace('{name}', name)}
    </a>
  </div>
</article>

<style>
  .artist-card {
    display: grid;
    grid-template-rows: auto 1fr;
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    transition: border-color var(--duration-fast) ease;
  }

  .artist-card:hover {
    border-color: var(--color-muted);
  }

  .artist-card__image-wrap {
    aspect-ratio: 4 / 5;
    background: var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .artist-card__initial {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 900;
    color: var(--color-muted);
    line-height: 1;
    user-select: none;
  }

  .artist-card__body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .artist-card__name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-ink);
    letter-spacing: -0.02em;
  }

  .artist-card__specialties {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  .artist-card__tag {
    font-size: var(--text-xs);
    font-family: var(--font-body);
    color: var(--color-muted);
    border: var(--border-width) solid var(--color-border);
    padding: var(--space-1) var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .artist-card__bio {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 55ch;
  }

  .artist-card__book {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-border);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-accent-dim);
    transition: text-decoration-color var(--duration-fast) ease;
  }

  .artist-card__book:hover {
    text-decoration-color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .artist-card,
    .artist-card__book {
      transition: none;
    }
  }
</style>
