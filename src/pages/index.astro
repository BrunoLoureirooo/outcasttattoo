---
import Base from '@/layouts/Base.astro'
import Nav from '@/components/shared/Nav.astro'
import Footer from '@/components/shared/Footer.astro'
import Hero from '@/components/sections/Hero.astro'
import EventsList from '@/components/sections/EventsList.astro'
import LatestPieces from '@/components/sections/LatestPieces.astro'
import LocationMap from '@/components/sections/LocationMap.astro'
import Loader from '@/components/shared/Loader.astro'
import { strings } from '@/content/strings.pt.ts'
import { getUpcomingEvents } from '@/lib/directus.ts'

const { pages } = strings.meta

// JSON-LD Event markup for upcoming events (same build-time filter as EventsList)
const eventsJsonLd = (await getUpcomingEvents())
  .map(ev => ({
    '@context': 'https://schema.org',
    '@type':    'Event',
    name:        ev.name,
    startDate:   ev.date,
    ...(ev.endDate ? { endDate: ev.endDate } : {}),
    ...(ev.url ? { url: ev.url } : {}),
    location: {
      '@type':          'Place',
      name:              ev.location,
      address: {
        '@type':          'PostalAddress',
        addressLocality:   ev.city,
        addressCountry:   'PT',
      },
    },
    performer: {
      '@type': 'Organization',
      name:     strings.jsonLd.name,
    },
  }))
---

<Base
  title={pages.home.title}
  description={pages.home.description}
  ogImage={pages.home.ogImage}
>
  <Loader />
  <Nav />
  <main id="main-content">
    <Hero />
    <LatestPieces />
    <EventsList />
  </main>
  <LocationMap />
  <Footer />
  {eventsJsonLd.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify(eventsJsonLd)} />
  )}
</Base>
